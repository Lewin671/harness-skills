#!/usr/bin/env bash
set -euo pipefail

src_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

default_dest_roots=(
  "${HOME}/.agents/skills"
  "${HOME}/.claude/skills"
  "${HOME}/.codex/skills"
  "${HOME}/.kiro/skills"
)

if [ "$#" -gt 0 ]; then
  dest_roots=("$@")
else
  dest_roots=("${default_dest_roots[@]}")
fi

# Harness id for a destination root, inferred from its path.
# Unknown/shared destinations (e.g. ~/.agents/skills) get an empty id
# and receive only unrestricted skills.
dest_root_harness() {
  case "$(casefold_path "$1")" in
    *"/.claude/"*) echo "claude-code" ;;
    *"/.codex/"*)  echo "codex" ;;
    *"/.kiro/"*)   echo "kiro" ;;
    *)             echo "" ;;
  esac
}

# Print the skill's `harnesses:` frontmatter list (space-separated),
# nothing when the skill is unrestricted, or `__parse_error__` when the
# frontmatter cannot be trusted — callers must fail closed on that.
# Fail closed on *shape* errors too, not just parse exceptions: missing
# delimiters, a non-mapping document, or a harnesses key that is not a
# non-empty string array all parse "successfully" but say nothing
# reliable about where the skill may be linked.
skill_harnesses() {
  ruby -ryaml -e '
    begin
      content = File.read(ARGV[0])
      unless content =~ /\A---\s*\n(.*?)\n---\s*(\n|\z)/m
        puts "__parse_error__"
        exit
      end
      meta = YAML.safe_load(Regexp.last_match(1))
      unless meta.is_a?(Hash)
        puts "__parse_error__"
        exit
      end
      unless meta.key?("harnesses")
        exit # unrestricted: valid frontmatter, no harness restriction
      end
      harnesses = meta["harnesses"]
      if harnesses.is_a?(Array) && !harnesses.empty? &&
         harnesses.all? { |h| h.is_a?(String) && !h.strip.empty? }
        puts harnesses.join(" ")
      else
        puts "__parse_error__"
      end
    rescue StandardError
      puts "__parse_error__"
    end
  ' "$1" 2>/dev/null || echo "__parse_error__"
}

skill_allowed_in_dest() {
  local skill_dir="$1"
  local dest_harness="$2"
  local harnesses harness

  harnesses="$(skill_harnesses "${skill_dir}/SKILL.md")"
  if [ "${harnesses}" = "__parse_error__" ]; then
    echo "warn  $(basename "${skill_dir}") (frontmatter unreadable: linking nowhere until fixed)" >&2
    parse_error_seen=1
    return 1
  fi
  [ -n "${harnesses}" ] || return 0

  for harness in ${harnesses}; do
    if [ "${harness}" = "${dest_harness}" ]; then
      return 0
    fi
  done
  return 1
}

is_repo_managed_link() {
  local path="$1"
  local target

  target="$(normalized_link_target "${path}")" || return 1
  path_is_under "${target}" "${src_root}"
}

casefold_path() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'
}

paths_equal() {
  [ "$(casefold_path "$1")" = "$(casefold_path "$2")" ]
}

path_is_under() {
  local path base

  path="$(casefold_path "$1")"
  base="$(casefold_path "$2")"
  [[ "${path}" = "${base}"/* ]]
}

normalized_path() {
  local path="$1"
  local parent

  parent="$(cd "$(dirname "${path}")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "${parent}" "$(basename "${path}")"
}

normalized_link_target() {
  local path="$1"
  local target

  target="$(readlink "${path}")"
  if [[ "${target}" != /* ]]; then
    target="$(cd "$(dirname "${path}")" && pwd -P)/${target}"
  fi

  normalized_path "${target}"
}

cleanup_invalid_links() {
  local dest_root="$1"
  local dest_harness
  local dest_path skill_name expected_target target

  dest_harness="$(dest_root_harness "${dest_root}")"

  for dest_path in "${dest_root}"/*; do
    [ -L "${dest_path}" ] || continue
    skill_name="$(basename "${dest_path}")"
    expected_target="${src_root}/${skill_name}"
    target="$(normalized_link_target "${dest_path}" 2>/dev/null || true)"

    if [ ! -e "${dest_path}" ]; then
      if is_repo_managed_link "${dest_path}"; then
        rm "${dest_path}"
        echo "clean ${skill_name} (broken link)"
        removed=$((removed + 1))
      fi
      continue
    fi

    if ! is_repo_managed_link "${dest_path}"; then
      continue
    fi

    if [ ! -f "${expected_target}/SKILL.md" ] || ! paths_equal "${target}" "${expected_target}"; then
      rm "${dest_path}"
      echo "clean ${skill_name} (stale link)"
      removed=$((removed + 1))
      continue
    fi

    if ! skill_allowed_in_dest "${expected_target}" "${dest_harness}"; then
      rm "${dest_path}"
      echo "clean ${skill_name} (harness mismatch: not for ${dest_harness:-shared} dest)"
      removed=$((removed + 1))
    fi
  done
}

sync_dest_root() {
  local dest_root="$1"
  local dest_harness
  local linked=0
  local skipped=0
  local removed=0
  local skill_dir skill_name dest_path target

  dest_harness="$(dest_root_harness "${dest_root}")"
  mkdir -p "${dest_root}"

  cleanup_invalid_links "${dest_root}"

  for skill_dir in "${src_root}"/*; do
    [ -d "${skill_dir}" ] || continue
    [ -f "${skill_dir}/SKILL.md" ] || continue

    skill_name="$(basename "${skill_dir}")"
    dest_path="${dest_root}/${skill_name}"

    if ! skill_allowed_in_dest "${skill_dir}" "${dest_harness}"; then
      echo "skip  ${skill_name} (harness-restricted: not for ${dest_harness:-shared} dest)"
      skipped=$((skipped + 1))
      continue
    fi

    if [ -L "${dest_path}" ]; then
      target="$(normalized_link_target "${dest_path}" 2>/dev/null || true)"
      if [ -n "${target}" ] && paths_equal "${target}" "${skill_dir}"; then
        echo "skip  ${skill_name} (already linked)"
        skipped=$((skipped + 1))
        continue
      fi
      rm "${dest_path}"
    elif [ -e "${dest_path}" ]; then
      echo "skip  ${skill_name} (destination exists and is not a symlink: ${dest_path})" >&2
      skipped=$((skipped + 1))
      continue
    fi

    ln -s "${skill_dir}" "${dest_path}"
    echo "link  ${skill_name} -> ${dest_path}"
    linked=$((linked + 1))
  done

  echo "done  linked=${linked} skipped=${skipped} removed=${removed} dest=${dest_root}"
}

parse_error_seen=0

for dest_root in "${dest_roots[@]}"; do
  sync_dest_root "${dest_root}"
done

if [ "${parse_error_seen}" -ne 0 ]; then
  echo "error: at least one skill has unreadable frontmatter and was linked nowhere" >&2
  exit 1
fi
