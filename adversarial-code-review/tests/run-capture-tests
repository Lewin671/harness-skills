#!/usr/bin/env bash
# Does the Phase 0 capture recipe actually run?
#
# The other prose protection. Two review rounds found runtime defects in this
# block that `bash -n` cannot see — `|| true` swallowing a hard failure, a
# `return` outside any function, a manifest group whose last command is a
# false test and so fails under pipefail. Syntax checking proves none of that.
#
# The block is EXTRACTED from orchestration.md, not copied, for the same
# reason as the snapshot recipe: a copy is a second source of truth and the
# wrong one gets fixed. It is not runnable verbatim — the recipe lists the
# scope alternatives in sequence for a human to choose between — so the
# harness supplies the scope and runs everything after it.
#
# Exit 0 when the recipe captures what it claims to. 1 otherwise.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DOC="${HERE}/../references/orchestration.md"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/acr-cap-XXXXXX")" && [ -n "$WORK" ] || {
  echo "cannot create the test workspace" >&2; exit 1; }
trap 'rm -rf "${WORK}"' EXIT
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

pass=0 fail=0
ok()  { pass=$((pass + 1)); printf 'ok   - %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf 'FAIL - %s%s\n' "$1" "${2:+ ($2)}"; }

# The unfiltered capture block: the one that ends by building `included`.
python3 - "$DOC" "${WORK}/capture.sh" <<'PY'
import re, sys, pathlib
doc = pathlib.Path(sys.argv[1]).read_text()
blocks = re.findall(r'```bash\n(.*?)```', doc, re.S)
picked = [b for b in blocks if 'patch_sha256=' in b and 'acr_manifest()' in b]
if len(picked) != 1:
    sys.exit(f"expected exactly one unfiltered capture block, found {len(picked)}")
out = []
for line in picked[0].splitlines():
    # The scope alternatives are a menu, not a sequence: each assignment
    # overwrites the last and two of them name variables a real caller sets.
    # The harness picks one and prepends it.
    if re.match(r'\s*(paths|diff_args)=\(', line):
        continue
    out.append(line)
pathlib.Path(sys.argv[2]).write_text('\n'.join(out) + '\n')
PY
[ $? -eq 0 ] || { echo "could not extract the capture block from ${DOC}"; exit 1; }

# The filtered recipe and the changed-range generator are executable Phase 0
# protections too: exclusions have to reach the patch, the untracked files AND
# both manifests, and the range awk has to handle deletion-only hunks and
# wholly deleted files. Neither was ever run.
python3 - "$DOC" "${WORK}/filtered.sh" "${WORK}/ranges.sh" <<'PY2'
import re, sys, pathlib
doc = pathlib.Path(sys.argv[1]).read_text()
blocks = re.findall(r'```bash\n(.*?)```', doc, re.S)
filtered = [b for b in blocks if 'excludes=(' in b and 'comm -23' in b]
ranges = [b for b in blocks if '--unified=0' in b]
if len(filtered) != 1 or len(ranges) != 1:
    sys.exit(f"expected one filtered block and one range block, found {len(filtered)} and {len(ranges)}")
pathlib.Path(sys.argv[2]).write_text(filtered[0])
pathlib.Path(sys.argv[3]).write_text(ranges[0])
PY2
[ $? -eq 0 ] || { echo "could not extract the filtered or range block from ${DOC}"; exit 1; }

# acr_manifest on its own. The filtered recipe calls it, so a fixture that
# wants the filtered block's OWN enumeration to be the first git call cannot
# reach it through capture.sh — sourcing that spends three calls first, and a
# shim aimed at "the first one" then lands on the wrong guard. Extracted
# separately so the filtered block can be driven with nothing else in front.
python3 - "$DOC" "${WORK}/manifest_fn.sh" <<'PYFN'
import re, sys, pathlib
doc = pathlib.Path(sys.argv[1]).read_text()
m = re.search(r'^acr_manifest\(\) \{.*?^\}$', doc, re.S | re.M)
if not m:
    sys.exit("could not find the acr_manifest definition")
pathlib.Path(sys.argv[2]).write_text(m.group(0) + "\n")
PYFN
[ $? -eq 0 ] || { echo "could not extract acr_manifest from ${DOC}"; exit 1; }

# The NUL-safe manifest builder. Nothing extracted it before, so it had never
# been executed at all — neither its two producers nor the array it fills.
python3 - "$DOC" "${WORK}/included_arr.sh" <<'PYARR'
import re, sys, pathlib
doc = pathlib.Path(sys.argv[1]).read_text()
blocks = re.findall(r'```bash\n(.*?)```', doc, re.S)
picked = [b for b in blocks if 'included_arr=()' in b]
if len(picked) != 1:
    sys.exit(f"expected one included_arr block, found {len(picked)}")
pathlib.Path(sys.argv[2]).write_text(picked[0])
PYARR
[ $? -eq 0 ] || { echo "could not extract the included_arr block from ${DOC}"; exit 1; }

python3 - "$DOC" "${WORK}/submodules.sh" <<'PY3'
import re, sys, pathlib
doc = pathlib.Path(sys.argv[1]).read_text()
blocks = re.findall(r'```bash\n(.*?)```', doc, re.S)
picked = [b for b in blocks if 'acr_submodules=' in b]
if len(picked) != 1:
    sys.exit(f"expected one submodule block, found {len(picked)}")
pathlib.Path(sys.argv[2]).write_text(picked[0])
PY3
[ $? -eq 0 ] || { echo "could not extract the submodule block from ${DOC}"; exit 1; }

# Run the recipe in $1 with the scope prelude in $2. Echoes the exit status;
# leaves the recipe's own variables in ${WORK}/vars for the caller to read.
# `vars` is newline-delimited and so cannot carry a scratch path containing a
# newline — sourcing it would truncate the value at the break and the caller
# would compare a path that does not exist. tmp-raw is the whole thing, and
# the one test that needs it reads that instead.
# The harness does NOT set -euo pipefail. It used to, and that made every
# case here a test of a shell the recipe never runs in: an agent pastes the
# block into a plain Bash call, where a failing `git diff` is just a nonzero
# status nobody reads. The recipe carries its own errexit now, and the point
# of not injecting it is that a regression removing that line goes red here.
run_capture() {
  local dir="$1" prelude="$2" status=0
  (
    cd "$dir" || exit 1
    eval "$prelude"
    # shellcheck source=/dev/null
    . "${WORK}/capture.sh"
    printf 'tmp=%s\npatch_sha256=%s\nbase_sha=%s\n' "$tmp" "$patch_sha256" "$base_sha" > "${WORK}/vars"
    printf '%s' "$tmp" > "${WORK}/tmp-raw"
    printf '%s\n' "$included" > "${WORK}/included"
  ) || status=$?
  printf '%s' "$status"
}

commit_env=(-c user.email=t@t -c user.name=t)


new_repo() {
  local d="${WORK}/$1"
  git init -q "$d"
  printf 'one\n' > "$d/tracked.txt"
  git -C "$d" add -A
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m base
  printf 'two\n' >> "$d/tracked.txt"
  printf 'new\n' > "$d/untracked.txt"
  printf '%s' "$d"
}

# --- the uncommitted scope, end to end -------------------------------------

repo="$(new_repo plain)"
status="$(run_capture "$repo" 'diff_args=(HEAD); untracked=1')"
if [ "$status" = 0 ]; then
  ok "the uncommitted capture recipe runs under set -euo pipefail"
else
  bad "the uncommitted capture recipe runs under set -euo pipefail" "exit $status"
fi

# shellcheck source=/dev/null
[ -f "${WORK}/vars" ] && . "${WORK}/vars"
if [ -s "${tmp:-/nonexistent}/patch.diff" ]; then
  ok "the captured patch is non-empty"
else
  bad "the captured patch is non-empty"
fi

# The patch has to APPLY at base_sha — that binding is the whole reason the
# attack phase can trust what it is testing.
applied="${WORK}/applied"
git clone -q "$repo" "$applied" 2>/dev/null
if git -C "$applied" checkout -q --detach "${base_sha:-HEAD}" 2>/dev/null &&
   git -C "$applied" apply --check "${tmp}/patch.diff" 2>/dev/null; then
  ok "the captured patch applies cleanly at base_sha"
else
  bad "the captured patch applies cleanly at base_sha"
fi

if grep -qx 'tracked.txt' "${WORK}/included" && grep -qx 'untracked.txt' "${WORK}/included"; then
  ok "the manifest names both the tracked and the untracked change"
else
  bad "the manifest names both changes" "$(tr '\n' ' ' < "${WORK}/included")"
fi

# --- the branch scope, where untracked=0 -----------------------------------
#
# This is the combination that failed under pipefail: with no untracked files
# the manifest group used to end in a false test.

branch="$(new_repo branch)"
git -C "$branch" add -A
git -C "$branch" -c user.email=t@t -c user.name=t commit -q -m work
base="$(git -C "$branch" rev-parse HEAD~1)"
status="$(run_capture "$branch" "diff_args=(${base} HEAD); untracked=0")"
if [ "$status" = 0 ]; then
  ok "the branch capture recipe runs with untracked=0"
else
  bad "the branch capture recipe runs with untracked=0" "exit $status"
fi

# --- an untracked filename that begins with a dash -------------------------

dashy="$(new_repo dashy)"
printf 'leading dash\n' > "${dashy}/-weird.txt"
status="$(run_capture "$dashy" 'diff_args=(HEAD); untracked=1')"
# shellcheck source=/dev/null
. "${WORK}/vars"
if [ "$status" = 0 ] && grep -q -- '-weird.txt' "${tmp}/patch.diff"; then
  ok "an untracked file whose name begins with a dash is captured"
else
  bad "an untracked file whose name begins with a dash is captured" "exit $status"
fi

# --- a tracked binary change has to arrive as an applicable delta ----------
#
# Without --binary a binary change becomes "Binary files ... differ", which
# `git apply` refuses — so the attack phase would bind a patch it cannot use.

binrepo="$(new_repo binary)"
printf '\000\001\002bin\000' > "${binrepo}/blob.bin"
git -C "$binrepo" add blob.bin
git -C "$binrepo" -c user.email=t@t -c user.name=t commit -q -m blob
printf '\000\003\004changed\000' > "${binrepo}/blob.bin"
status="$(run_capture "$binrepo" 'diff_args=(HEAD); untracked=1')"
# shellcheck source=/dev/null
. "${WORK}/vars"
binapplied="${WORK}/bin-applied"
git clone -q "$binrepo" "$binapplied" 2>/dev/null
if [ "$status" = 0 ] &&
   git -C "$binapplied" checkout -q --detach "${base_sha}" 2>/dev/null &&
   git -C "$binapplied" apply --check "${tmp}/patch.diff" 2>/dev/null; then
  ok "a tracked binary change is captured as an applicable delta"
else
  bad "a tracked binary change is captured as an applicable delta" "exit $status"
fi

# --- a capture failure must stop the run -----------------------------------
#
# `git diff --no-index` exits 1 for "they differ", which is the ordinary case,
# and above 1 for a real failure. Swallowing both dropped a file from the
# patch while the manifest still named it.

unreadable="$(new_repo unreadable)"
printf 'secret\n' > "${unreadable}/locked.txt"
chmod 000 "${unreadable}/locked.txt"
status="$(run_capture "$unreadable" 'diff_args=(HEAD); untracked=1')"
chmod 644 "${unreadable}/locked.txt"
if [ "$status" != 0 ]; then
  ok "an uncapturable untracked file stops the capture"
else
  bad "an uncapturable untracked file stops the capture" "exit 0, the file was dropped silently"
fi

# The scratch directory must SURVIVE the capture. Nothing may clean it up:
# the attack phase reads patch.diff from it in a later Bash call, and the
# post-run snapshot compares against tree-before taken in the first one. A
# recipe that tidied up after itself would break both, silently — the patch
# would be gone by the time an attack tried to apply it.
if [ -d "${tmp:-/nonexistent}" ] && [ -s "${tmp}/patch.diff" ] && [ -f "${tmp}/index-copy" ]; then
  ok "the Phase 0 scratch directory and its patch outlive the capture"
else
  bad "the Phase 0 scratch directory and its patch outlive the capture" \
    "tmp=${tmp:-unset}, patch=$([ -s "${tmp:-/nonexistent}/patch.diff" ] && echo present || echo missing)"
fi

# ...and a FAILED capture must not leave one behind. Success needs
# persistence; failure exits under `set -e` before anything can name the
# directory, so every retry would otherwise leave another unannounced copy of
# a partial diff and the index.
failtmp="$(new_repo failcap)"
fail_out="${WORK}/failcap.out"
# A TMPDIR of its own, so the count cannot race. Comparing global
# `${TMPDIR}/acr-*` counts made this assertion depend on what other reviews
# were doing: a concurrent successful capture between the snapshots fails it,
# and an unrelated deletion can offset this test's own leak into a false pass.
# AGENTS.md says concurrent agents are expected, so a global count is not
# evidence about this run.
failscratch="${WORK}/failcap-scratch"
mkdir -p "$failscratch"
acr_dirs_before="$(ls -d "${failscratch}"/acr-* 2>/dev/null | wc -l | tr -d ' ')"
( cd "$failtmp" || exit 1
  export TMPDIR="$failscratch"
  # A scope git cannot resolve: the capture dies after mktemp, before the
  # patch is complete.
  diff_args=(no-such-ref-zzz); untracked=0
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh"
  printf '%s' "$tmp" > "${WORK}/failcap-tmp" ) > "$fail_out" 2>&1
fail_status=$?
leftover="$(ls -d "${failscratch}"/acr-* 2>/dev/null | wc -l | tr -d ' ')"
if [ "$fail_status" != 0 ] && [ "$leftover" = "$acr_dirs_before" ]; then
  ok "a failed capture leaves no unannounced scratch directory"
else
  bad "a failed capture leaves no unannounced scratch directory" \
    "exit $fail_status, acr-* dirs before=$acr_dirs_before after=$leftover"
fi

# `TMPDIR=-P` must not be read as an OPTION. `cd` is a builtin that parses its
# own options, so without the `--` terminator `cd "$acr_root"` becomes `cd -P`
# with no operand — which SUCCEEDS and lands on $HOME. Every Phase 0 scratch
# file, both tree snapshots included, would then be written into the user's
# home directory while the containment checks below judge the wrong directory
# entirely. Quoting does not stop it; only the terminator does.
#
# HOME is redirected at a fixture for the duration, so the failure mode is
# observable without writing anything into the real one — and so the
# assertion is about where scratch LANDED rather than about a message.
dashhome="${WORK}/dash-home"
mkdir -p "$dashhome"
dashrepo="$(new_repo dashopt)"
dash_status="$( ( cd "$dashrepo" || exit 1
  export HOME="$dashhome" TMPDIR=-P
  diff_args=(HEAD); untracked=1
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh"
  printf '%s' "$tmp" > "${WORK}/dash-tmp" ) > /dev/null 2>&1; printf '%s' "$?" )"
dash_tmp="$(cat "${WORK}/dash-tmp" 2>/dev/null)"
dashhome_real="$(cd "$dashhome" && pwd -P)"
dash_tmp_real="$(cd "$dash_tmp" 2>/dev/null && pwd -P)" || dash_tmp_real="$dash_tmp"
case "${dash_tmp_real}/" in
  "${dashhome_real}"/*) dash_in_home=yes ;;
  *) dash_in_home=no ;;
esac
if [ "$dash_status" = 0 ] && [ "$dash_in_home" = no ]; then
  ok "TMPDIR=-P does not put scratch in the home directory"
else
  bad "TMPDIR=-P does not put scratch in the home directory" \
    "exit $dash_status, tmp=${dash_tmp}"
fi

# The checkout root of a SEPARATE-GIT-DIR repository. Measured on git 2.39.5:
# `git worktree list --porcelain` reports the git STORAGE as the worktree
# record and omits the checkout entirely, so nothing in the containment loop
# ever names the tree being reviewed — and a TMPDIR inside it was accepted.
# Phase 0 then wrote the patch, both snapshots and the manifests into the very
# tree it was about to diff, before the baseline that could disclose it.
sgd_git="${WORK}/sgd-storage"
sgd_wt="${WORK}/sgd-checkout"
mkdir -p "$sgd_git"
git init -q --separate-git-dir="$sgd_git" "$sgd_wt" 2>/dev/null
if [ -d "$sgd_wt" ]; then
  printf 'one\n' > "${sgd_wt}/tracked.txt"
  git -C "$sgd_wt" add -A
  git -C "$sgd_wt" "${commit_env[@]}" commit -q -m base
  printf 'two\n' >> "${sgd_wt}/tracked.txt"
  mkdir -p "${sgd_wt}/scratch"
  sgd_status="$(TMPDIR="${sgd_wt}/scratch" run_capture "$sgd_wt" 'diff_args=(HEAD); untracked=1')"
  sgd_tmp="$(cat "${WORK}/tmp-raw" 2>/dev/null)"
  sgd_wt_real="$(cd "$sgd_wt" && pwd -P)"
  sgd_tmp_real="$(cd "$sgd_tmp" 2>/dev/null && pwd -P)" || sgd_tmp_real="$sgd_tmp"
  case "${sgd_tmp_real}/" in
    "${sgd_wt_real}"/*) sgd_in_wt=yes ;;
    *) sgd_in_wt=no ;;
  esac
  if [ "$sgd_status" = 0 ] && [ "$sgd_in_wt" = no ]; then
    ok "scratch stays out of a separate-git-dir checkout"
  else
    bad "scratch stays out of a separate-git-dir checkout" "exit $sgd_status, tmp=${sgd_tmp}"
  fi
else
  bad "scratch stays out of a separate-git-dir checkout" "fixture: git refused --separate-git-dir"
fi

# A carriage return, not only a newline. It forges no record here, but the
# Workflow boundary refuses any patch_path carrying one — so without this the
# recipe persisted a scratch directory and produced a capture that nothing
# downstream could consume, which is a worse outcome than refusing.
crtmp="${WORK}/cr$(printf '\r')dir"
mkdir -p "$crtmp"
cr_out="${WORK}/cr-refusal.out"
( cd "$repo" || exit 1
  export TMPDIR="$crtmp"
  diff_args=(HEAD); untracked=1
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh" ) > "$cr_out" 2>&1
cr_status=$?
if [ "$cr_status" != 0 ] && grep -q 'line break' "$cr_out"; then
  ok "the capture recipe refuses a scratch path containing a carriage return"
else
  bad "the capture recipe refuses a scratch path containing a carriage return" \
    "exit=$cr_status"
fi

# A scratch path carrying a line break must be refused, not used. The §8
# handoff prints `tmp=%s\nbase_sha=%s\n`, so a TMPDIR ending in a newline
# followed by `base_sha=<forty hex>` produces a handoff whose second record
# reads as a base commit nobody captured — every attack in the review would
# then bind to the wrong tree while the format looks intact. mktemp itself is
# perfectly happy to create such a directory, so nothing downstream notices.
lf='
'
nltmp="${WORK}/nl${lf}base_sha=0000000000000000000000000000000000000000"
mkdir -p "$nltmp"
nl_out="${WORK}/nl-refusal.out"
( cd "$repo" || exit 1
  export TMPDIR="$nltmp"
  diff_args=(HEAD); untracked=1
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh" ) > "$nl_out" 2>&1
nl_status=$?
# Both halves matter: refusing is the point, and the message has to name the
# cause or the user retries into the same wall.
if [ "$nl_status" != 0 ] && grep -q 'line break' "$nl_out"; then
  ok "the capture recipe refuses a scratch path containing a line break"
else
  bad "the capture recipe refuses a scratch path containing a line break" \
    "exit=$nl_status, output: $(tr '\n' ' ' < "$nl_out" | cut -c1-160)"
fi

# The recipe is bash-only and must SAY so by refusing. Under zsh — the default
# login shell on macOS — arrays are 1-indexed, so `${diff_args[0]}` is unset and
# `base_sha` comes out empty while the patch is still written and hashed: a
# binding that is internally consistent and describes the wrong thing.
if ! grep -q 'BASH_VERSION' "${WORK}/capture.sh"; then
  bad "the capture recipe refuses a non-bash shell" "no BASH_VERSION guard in the extracted block"
elif command -v zsh >/dev/null 2>&1; then
  zsh_out="${WORK}/zsh-refusal.out"
  ( cd "$repo" && export TMPDIR="${WORK}" && zsh -c "diff_args=(HEAD); untracked=1; . '${WORK}/capture.sh'" ) \
    > "$zsh_out" 2>&1
  zsh_status=$?
  if [ "$zsh_status" != 0 ] && grep -q 'requires bash' "$zsh_out"; then
    ok "the capture recipe refuses a non-bash shell"
  else
    bad "the capture recipe refuses a non-bash shell" "zsh exit=$zsh_status"
  fi
else
  # Not a silent skip: the guard's presence is asserted above either way, and
  # this says plainly which half could not run here.
  ok "the capture recipe carries a bash guard (zsh absent, refusal not exercised)"
fi

# --- Phase 0 run from a SUBDIRECTORY ---------------------------------------
#
# `git ls-files` is scoped to the current directory and prints paths relative
# to it — unlike `git diff` and `git status`. Measured: from `src/`, it omits
# a sibling `vendor/` entry and reports `src/s.txt` as `s.txt`. Every
# enumeration in the recipe is an ls-files, so without the cd to the top level
# a Phase 0 run from anywhere but the root silently reviews a subtree while
# reporting it as the repository. Nothing covered this before.
subd="$(new_repo subdir)"
mkdir -p "${subd}/src" "${subd}/vendor"
printf 'v\n' > "${subd}/vendor/v.txt"
printf 's\n' > "${subd}/src/s.txt"
git -C "$subd" add -A
git -C "$subd" "${commit_env[@]}" commit -q -m sub
printf 'edited\n' >> "${subd}/vendor/v.txt"
printf 'edited\n' >> "${subd}/src/s.txt"
printf 'fresh\n' > "${subd}/vendor/new.txt"
status="$(run_capture "${subd}/src" 'diff_args=(HEAD); untracked=1')"
if [ "$status" != 0 ]; then
  bad "the capture recipe runs from a subdirectory" "exit $status"
else
  ok "the capture recipe runs from a subdirectory"
  # The sibling directory's tracked change and its untracked file both have to
  # be in the manifest, under paths relative to the ROOT.
  if grep -qx 'vendor/v.txt' "${WORK}/included" && grep -qx 'src/s.txt' "${WORK}/included"; then
    ok "a subdirectory run still names every changed path from the root"
  else
    bad "a subdirectory run still names every changed path from the root" "$(tr '\n' '|' < "${WORK}/included")"
  fi
  if grep -qx 'vendor/new.txt' "${WORK}/included"; then
    ok "a subdirectory run still names untracked files outside the cwd"
  else
    bad "a subdirectory run still names untracked files outside the cwd" "$(tr '\n' '|' < "${WORK}/included")"
  fi
fi

# --- a submodule path may contain spaces -----------------------------------
#
# The recipe promises to NAME uncaptured submodules so they can be reviewed as
# their own scope. Splitting `git submodule status` on whitespace returns half
# of `libs/payment core`, which names the wrong path and cannot be reviewed.

subhost="${WORK}/subhost"
subinner="${WORK}/subinner"
git init -q "$subinner"
printf 'inner\n' > "${subinner}/i.txt"
git -C "$subinner" add -A
git -C "$subinner" "${commit_env[@]}" commit -q -m inner
git init -q "$subhost"
printf 'outer\n' > "${subhost}/o.txt"
git -C "$subhost" add -A
git -C "$subhost" "${commit_env[@]}" commit -q -m outer
if git -C "$subhost" -c protocol.file.allow=always "${commit_env[@]}" \
     submodule add -q "$subinner" 'libs/payment core' >/dev/null 2>&1; then
  sub_out="${WORK}/submodules.out"
  ( cd "$subhost" && set -euo pipefail
    # shellcheck source=/dev/null
    . "${WORK}/submodules.sh"
    printf '%s\n' ${acr_submodules[@]+"${acr_submodules[@]}"} ) > "$sub_out" 2>/dev/null
  sub_status=$?
  if [ "$sub_status" = 0 ] && grep -qx 'libs/payment core' "$sub_out"; then
    ok "a submodule path containing a space is named whole"
  else
    bad "a submodule path containing a space is named whole" "exit $sub_status, got: $(tr '\n' '|' < "$sub_out")"
  fi
else
  bad "a submodule path containing a space is named whole" "could not create the submodule fixture"
fi

# And a path containing ` (`. BRE is greedy and the expression is anchored, so
# ` (.*)$` strips from the FIRST ` (` on the line, not from the describe
# suffix: `libs/foo (legacy)` came back as `libs/foo`, and the report then
# named an uncaptured scope that does not exist and cannot be reviewed.
if git -C "$subhost" -c protocol.file.allow=always "${commit_env[@]}" \
     submodule add -q "$subinner" 'libs/foo (legacy)' >/dev/null 2>&1; then
  sub_out="${WORK}/submodules-paren.out"
  ( cd "$subhost" && set -euo pipefail
    # shellcheck source=/dev/null
    . "${WORK}/submodules.sh"
    printf '%s\n' ${acr_submodules[@]+"${acr_submodules[@]}"} ) > "$sub_out" 2>/dev/null
  sub_status=$?
  if [ "$sub_status" = 0 ] && grep -qx 'libs/foo (legacy)' "$sub_out"; then
    ok "a submodule path containing a parenthesis keeps it"
  else
    bad "a submodule path containing a parenthesis keeps it" "exit $sub_status, got: $(tr '\n' '|' < "$sub_out")"
  fi
else
  bad "a submodule path containing a parenthesis keeps it" "could not create the submodule fixture"
fi

# The other direction, which is why this stopped being a regex at all: the
# DESCRIBE suffix can itself contain `(`. `git check-ref-format` accepts a ref
# named `rel(legacy)`, so ` (rel(legacy))` is a legal suffix and a non-greedy
# ` ([^(]*)$` leaves it in place. Path and suffix can each contain the other's
# delimiter, so the line is ambiguous and only a fixed-field source is exact.
if git -C "$subinner" tag -f 'rel(legacy)' >/dev/null 2>&1 &&
   git -C "$subhost" -c protocol.file.allow=always "${commit_env[@]}" \
     submodule add -q "$subinner" 'libs/bar' >/dev/null 2>&1; then
  sub_out="${WORK}/submodules-describe.out"
  ( cd "$subhost" && set -euo pipefail
    # shellcheck source=/dev/null
    . "${WORK}/submodules.sh"
    printf '%s\n' ${acr_submodules[@]+"${acr_submodules[@]}"} ) > "$sub_out" 2>/dev/null
  sub_status=$?
  if [ "$sub_status" = 0 ] && grep -qx 'libs/bar' "$sub_out"; then
    ok "a submodule whose describe suffix contains a parenthesis is named whole"
  else
    bad "a submodule whose describe suffix contains a parenthesis is named whole" "exit $sub_status, got: $(tr '\n' '|' < "$sub_out")"
  fi
else
  bad "a submodule whose describe suffix contains a parenthesis is named whole" "could not create the submodule fixture"
fi

# --- and never inside a sibling worktree -----------------------------------
#
# A linked worktree shares its object store with the main checkout, which is
# outside both the current root and every git directory.

lwmain="$(new_repo lwmain)"
git -C "$lwmain" add -A
git -C "$lwmain" "${commit_env[@]}" commit -q -m work
# A path with a space: `for x in ${roots}` would split it into two roots that
# do not exist and miss the one that does.
lwlinked="${WORK}/lw linked"
git -C "$lwmain" worktree add -q -b lw "$lwlinked" >/dev/null 2>&1
printf 'dirty\n' > "${lwlinked}/untracked.txt"
mkdir -p "${lwmain}/scratch"
status="$(TMPDIR="${lwmain}/scratch" run_capture "$lwlinked" 'diff_args=(HEAD); untracked=1')"
# shellcheck source=/dev/null
. "${WORK}/vars"
lwmain_real="$(cd "$lwmain" && pwd -P)"
tmp_real="$(cd "$tmp" 2>/dev/null && pwd -P)" || tmp_real="$tmp"
case "${tmp_real}/" in
  "${lwmain_real}"/*) in_sibling=yes ;;
  *) in_sibling=no ;;
esac
if [ "$status" = 0 ] && [ "$in_sibling" = no ]; then
  ok "a TMPDIR in a sibling worktree is relocated too"
else
  bad "a TMPDIR in a sibling worktree is relocated too" "exit $status, tmp=${tmp}"
fi

# And the same for the worktree being reviewed, whose path contains a space.
# NOTE: this case passes with the array quoting removed as well — bash does
# split `${roots}` on the space (measured directly), but this fixture does not
# reach the branch where that changes the outcome. The quoting is kept because
# it is right, not because this proves it; said here rather than left to read
# as coverage.
mkdir -p "${lwlinked}/scratch"
status="$(TMPDIR="${lwlinked}/scratch" run_capture "$lwlinked" 'diff_args=(HEAD); untracked=1')"
# shellcheck source=/dev/null
. "${WORK}/vars"
lwlinked_real="$(cd "$lwlinked" && pwd -P)"
tmp_real="$(cd "$tmp" 2>/dev/null && pwd -P)" || tmp_real="$tmp"
case "${tmp_real}/" in
  "${lwlinked_real}"/*) in_self=yes ;;
  *) in_self=no ;;
esac
if [ "$status" = 0 ] && [ "$in_self" = no ]; then
  ok "a worktree path containing a space is still recognised"
else
  bad "a worktree path containing a space is still recognised" "exit $status, tmp=${tmp}"
fi

# A newline in a sibling worktree path. `git worktree list --porcelain` emits
# it RAW and unquoted, so a line reader gets two records and the real path in
# neither — the root is then never checked and a TMPDIR under it is accepted.
# Reviewed from the main checkout, so only the sibling record can catch it.
nlmain="$(new_repo nlmain)"
git -C "$nlmain" add -A
git -C "$nlmain" "${commit_env[@]}" commit -q -m work
nllinked="${WORK}/nl
wt"
git -C "$nlmain" worktree add -q -b nlwt "$nllinked" >/dev/null 2>&1
if [ -d "$nllinked" ]; then
  printf 'dirty\n' > "${nlmain}/untracked.txt"
  # Asserted on the ENUMERATION, not on where scratch landed. The older form
  # of this test put TMPDIR inside the newline-bearing worktree and checked
  # that the capture relocated it — coverage that the line-break guard on the
  # scratch root has since made unreachable, because every path under a
  # newline-bearing directory carries the newline and is now refused before
  # the worktree check runs. The refusal is correct and the enumeration bug is
  # still real, so the enumeration is pinned directly: with a clean TMPDIR,
  # the sibling worktree must appear in `acr_roots` as ONE entry equal to its
  # full path. A line reader yields two records and the real path in neither,
  # which is exactly how a root goes unchecked.
  nl_roots="${WORK}/nl-roots"
  ( cd "$nlmain" || exit 1
    export TMPDIR="${WORK}"
    diff_args=(HEAD); untracked=1
    # shellcheck source=/dev/null
    . "${WORK}/capture.sh"
    # NUL-separated: the values under test are the ones holding newlines.
    printf '%s\0' "${acr_roots[@]}" > "$nl_roots" ) > /dev/null 2>&1
  nl_status=$?
  nllinked_real="$(cd "$nllinked" && pwd -P)"
  nl_hit=no
  if [ -s "$nl_roots" ]; then
    while IFS= read -r -d '' nl_r; do
      [ "$nl_r" = "$nllinked_real" ] && nl_hit=yes
    done < "$nl_roots"
  fi
  if [ "$nl_status" = 0 ] && [ "$nl_hit" = yes ]; then
    ok "a worktree path containing a newline is still recognised"
  else
    bad "a worktree path containing a newline is still recognised" \
      "exit $nl_status, the sibling worktree is not one entry in acr_roots"
  fi
else
  bad "a worktree path containing a newline is still recognised" "fixture: git refused the path"
fi

# --- an enumeration that FAILS is not an empty one --------------------------
#
# A process substitution's exit status is unreachable from the shell reading
# it, and `set -euo pipefail` does not change that. A git that fails or is
# killed therefore reads as "no worktrees" and "no untracked files": the first
# lets scratch land in a sibling checkout, the second drops files from the
# patch while the manifest still names them.

shimdir="${WORK}/shim-bin"
mkdir -p "$shimdir"
real_git="$(command -v git)"
# Fail exactly ONE git subcommand, chosen by an environment variable, and pass
# everything else through. A shim that broke git in general would make the
# recipe exit for reasons that have nothing to do with the check under test.
cat > "${shimdir}/git" <<GITSHIM
#!/usr/bin/env bash
# Fail the Nth \`ls-files --others\` and no other, counted in a file so the
# count survives across the separate git processes the recipe runs. The
# recipe calls \`--others\` several times — the capture list first, then
# acr_manifest, which already propagates its own failure. Failing every one
# would prove only that the LATER guard works and leave the capture list
# untested, which is exactly the mistake this counter exists to avoid.
case "\${ACR_SHIM_FAIL:-}" in
  worktree) [ "\${1:-}" = worktree ] && [ "\${2:-}" = list ] && {
              echo "fatal: fixture forced worktree list to fail" >&2; exit 128; } ;;
  basesha)  # \`git rev-parse <rev>\` — the base_sha assignment, which has NO
            # explicit failure handling. Only errexit stops the recipe there,
            # so this is the case that proves the recipe carries its own.
            # Option forms (--git-path, --absolute-git-dir, ...) are left
            # alone; they are a different call with a different consequence.
            if [ "\${1:-}" = rev-parse ]; then
              case "\${2:-}" in
                -*) : ;;
                "") : ;;
                *)  echo "fatal: fixture forced rev-parse to fail" >&2; exit 128 ;;
              esac
            fi ;;
  patch)    if [ "\${1:-}" = diff ]; then
              # The TRACKED patch capture only: --binary without --no-index.
              # The untracked half uses --no-index and must keep working, or
              # the case would prove nothing about a partial artifact.
              hb=0; hn=0
              for a in "\$@"; do
                [ "\$a" = --binary ] && hb=1
                [ "\$a" = --no-index ] && hn=1
              done
              [ "\$hb" = 1 ] && [ "\$hn" = 0 ] && {
                echo "fatal: fixture forced the tracked patch capture to fail" >&2; exit 128; }
            fi ;;
  nameonly) if [ "\${1:-}" = diff ]; then
              for a in "\$@"; do [ "\$a" = --name-only ] && {
                echo "fatal: fixture forced diff --name-only to fail" >&2; exit 128; }
              done
            fi ;;
  lsfiles)  if [ "\${1:-}" = ls-files ]; then
              for a in "\$@"; do
                if [ "\$a" = --others ]; then
                  n=0; [ -f "\${ACR_SHIM_COUNT}" ] && n="\$(cat "\${ACR_SHIM_COUNT}")"
                  n=\$((n + 1)); printf '%s' "\$n" > "\${ACR_SHIM_COUNT}"
                  [ "\$n" = "\${ACR_SHIM_NTH:-1}" ] && {
                    echo "fatal: fixture forced ls-files --others #\$n to fail" >&2; exit 128; }
                  break
                fi
              done
            fi ;;
esac
exec "${real_git}" "\$@"
GITSHIM
chmod +x "${shimdir}/git"

shimrepo="$(new_repo shimrepo)"
git -C "$shimrepo" add -A
git -C "$shimrepo" "${commit_env[@]}" commit -q -m base
printf 'edit\n' >> "${shimrepo}/tracked.txt"
printf 'loose\n' > "${shimrepo}/loose.txt"

# Pass-through first: whatever the failing cases prove, it is not that the
# shim itself breaks the recipe.
status="$(PATH="${shimdir}:$PATH" run_capture "$shimrepo" 'diff_args=(HEAD); untracked=1')"
if [ "$status" = 0 ]; then
  ok "the git shim passes through when nothing is forced to fail"
else
  bad "the git shim passes through when nothing is forced to fail" "exit $status"
fi

status="$(ACR_SHIM_FAIL=worktree PATH="${shimdir}:$PATH" run_capture "$shimrepo" 'diff_args=(HEAD); untracked=1')"
if [ "$status" != 0 ]; then
  ok "a failing worktree enumeration stops the capture"
else
  bad "a failing worktree enumeration stops the capture" "exit 0 — the roots were never checked"
fi

rm -f "${WORK}/shim-count"
status="$(ACR_SHIM_FAIL=lsfiles ACR_SHIM_NTH=1 ACR_SHIM_COUNT="${WORK}/shim-count" \
  PATH="${shimdir}:$PATH" run_capture "$shimrepo" 'diff_args=(HEAD); untracked=1')"
if [ "$status" != 0 ]; then
  ok "a failing untracked enumeration stops the capture"
else
  bad "a failing untracked enumeration stops the capture" "exit 0 — the patch would omit untracked files the manifest names"
fi

# --- scratch never lands inside the repository -----------------------------

inside="$(new_repo inside)"
mkdir -p "${inside}/scratch"
status="$(TMPDIR="${inside}/scratch" run_capture "$inside" 'diff_args=(HEAD); untracked=1')"
# shellcheck source=/dev/null
. "${WORK}/vars"
# BOTH sides resolved with pwd -P. On macOS mktemp hands back /var/folders/...
# while the recipe reports /private/var/folders/... — comparing the two raw
# strings never matches, so this check passed with the relocation removed.
inside_real="$(cd "$inside" && pwd -P)"
tmp_real="$(cd "$tmp" 2>/dev/null && pwd -P)" || tmp_real="$tmp"
case "${tmp_real}/" in
  "${inside_real}"/*) inside_repo=yes ;;
  *) inside_repo=no ;;
esac
if [ "$status" = 0 ] && [ "$inside_repo" = no ]; then
  ok "a repo-local TMPDIR is relocated before anything is written"
else
  bad "a repo-local TMPDIR is relocated before anything is written" "exit $status, tmp=${tmp}"
fi

# --- exclusions reach the patch, the untracked files and both manifests ----

filt="$(new_repo filtered)"
printf 'lock\n' > "${filt}/package-lock.json"
mkdir -p "${filt}/vendor"
printf 'vendored\n' > "${filt}/vendor/lib.js"
filt_status=0
(
  cd "$filt" || exit 1
  set -euo pipefail
  diff_args=(HEAD); untracked=1
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh"
  # shellcheck source=/dev/null
  . "${WORK}/filtered.sh"
  printf 'tmp=%s\n' "$tmp" > "${WORK}/vars"
  printf '%s\n' "$included" > "${WORK}/included"
  printf '%s\n' "$excluded" > "${WORK}/excluded"
) || filt_status=$?
# shellcheck source=/dev/null
. "${WORK}/vars"
if [ "$filt_status" = 0 ] &&
   ! grep -q 'package-lock.json' "${tmp}/patch.diff" &&
   ! grep -q 'vendor/lib.js' "${tmp}/patch.diff" &&
   grep -q 'tracked.txt' "${tmp}/patch.diff" &&
   ! grep -qx 'package-lock.json' "${WORK}/included" &&
   grep -qx 'package-lock.json' "${WORK}/excluded"; then
  ok "exclusions reach the patch, the untracked files and both manifests"
else
  bad "exclusions reach the patch, the untracked files and both manifests" "exit $filt_status"
fi

# The FILTERED recipe has its own enumerations, and fixing the unfiltered ones
# said nothing about these: the untracked list it patches from, and the
# `included_arr` the NUL-safe manifest is built out of.
#
# Each block is driven with NOTHING in front of it — only acr_manifest, which
# it calls — so the enumeration under test is the shim's first call. Counting
# calls through a sourced capture.sh instead is what made the first three
# attempts at these cases pass against a removed guard: the run still failed,
# but at capture.sh's guard, several calls earlier.
run_filtered() {
  local fail="$1" st=0
  rm -f "${WORK}/shim-count"
  (
    cd "$filt" || exit 1
    set -euo pipefail
    export ACR_SHIM_FAIL="$fail" ACR_SHIM_NTH=1 ACR_SHIM_COUNT="${WORK}/shim-count"
    export PATH="${shimdir}:$PATH"
    tmp="$(mktemp -d "${WORK}/filt-XXXXXX")"
    diff_args=(HEAD); untracked=1
    # shellcheck source=/dev/null
    . "${WORK}/manifest_fn.sh"
    # shellcheck source=/dev/null
    . "${WORK}/filtered.sh"
  ) >/dev/null 2>&1 || st=$?
  printf '%s' "$st"
}
# Pass-through first, so a refusal below is the guard and not the shim.
if [ "$(run_filtered none)" = 0 ]; then
  ok "the filtered recipe runs with the shim passing everything through"
else
  bad "the filtered recipe runs with the shim passing everything through" "exit $(run_filtered none)"
fi
if [ "$(run_filtered lsfiles)" != 0 ]; then
  ok "a failing enumeration stops the filtered capture"
else
  bad "a failing enumeration stops the filtered capture" "exit 0 — the manifest would name what the patch omits"
fi
if [ "$(run_filtered patch)" != 0 ]; then
  ok "a failing tracked patch capture stops the filtered capture"
else
  bad "a failing tracked patch capture stops the filtered capture" "exit 0 — the hash would bind an incomplete patch"
fi

# The same for the unfiltered recipe, which is the one an agent reaches for
# first. A failed tracked capture leaves the untracked half still appending,
# the manifest still naming every path, and patch_sha256 hashing a patch that
# is missing the tracked changes — an artifact binding that is internally
# consistent and describes the wrong thing.
patchfail="$(new_repo patchfail)"
rm -f "${WORK}/shim-count"
pf_status=0
(
  cd "$patchfail" || exit 1
  export ACR_SHIM_FAIL=patch ACR_SHIM_NTH=1 ACR_SHIM_COUNT="${WORK}/shim-count"
  export PATH="${shimdir}:$PATH"
  diff_args=(HEAD); untracked=1
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh"
) >/dev/null 2>&1 || pf_status=$?
if [ "$pf_status" != 0 ]; then
  ok "a failing tracked patch capture stops the unfiltered capture"
else
  bad "a failing tracked patch capture stops the unfiltered capture" "exit 0 — patch_sha256 would bind a patch missing the tracked changes"
fi

# And a failure with NO explicit handler behind it. base_sha is a plain
# command substitution, so errexit is the only thing that can stop the recipe
# there — which makes this the case that proves the recipe brings its own
# `set -euo pipefail` rather than borrowing the harness's.
bs_status=0
(
  cd "$patchfail" || exit 1
  export ACR_SHIM_FAIL=basesha ACR_SHIM_NTH=1 ACR_SHIM_COUNT="${WORK}/shim-count"
  export PATH="${shimdir}:$PATH"
  diff_args=(HEAD); untracked=1
  # shellcheck source=/dev/null
  . "${WORK}/capture.sh"
) >/dev/null 2>&1 || bs_status=$?
if [ "$bs_status" != 0 ]; then
  ok "the recipe sets its own errexit (an unhandled failure stops it)"
else
  bad "the recipe sets its own errexit (an unhandled failure stops it)" "exit 0 — the recipe ran on with an empty base_sha"
fi

# The NUL-safe manifest builder, run for the first time. Its two producers are
# a `git diff` and a `git ls-files`, so the ls-files shim reaches one of them
# and a second shim mode is needed for the other.
run_included_arr() {
  local fail="$1" st=0
  rm -f "${WORK}/shim-count"
  (
    cd "$filt" || exit 1
    set -euo pipefail
    export ACR_SHIM_FAIL="$fail" ACR_SHIM_NTH=1 ACR_SHIM_COUNT="${WORK}/shim-count"
    export PATH="${shimdir}:$PATH"
    tmp="$(mktemp -d "${WORK}/iarr-XXXXXX")"
    diff_args=(HEAD); untracked=1
    excludes=(':(exclude)package-lock.json')
    # shellcheck source=/dev/null
    . "${WORK}/included_arr.sh"
    [ "${#included_arr[@]}" -gt 0 ] || exit 9
    printf '%s\n' "${included_arr[@]}" > "${WORK}/included-arr.out"
  ) >/dev/null 2>&1 || st=$?
  printf '%s' "$st"
}
if [ "$(run_included_arr none)" = 0 ] &&
   grep -qx 'tracked.txt' "${WORK}/included-arr.out" &&
   ! grep -qx 'package-lock.json' "${WORK}/included-arr.out"; then
  ok "the NUL-safe manifest builder runs and honours the exclusions"
else
  bad "the NUL-safe manifest builder runs and honours the exclusions" "exit $(run_included_arr none)"
fi
if [ "$(run_included_arr lsfiles)" != 0 ]; then
  ok "a failing untracked producer stops the NUL-safe manifest"
else
  bad "a failing untracked producer stops the NUL-safe manifest" "exit 0"
fi
if [ "$(run_included_arr nameonly)" != 0 ]; then
  ok "a failing changed-path producer stops the NUL-safe manifest"
else
  bad "a failing changed-path producer stops the NUL-safe manifest" "exit 0"
fi

# NOT TESTED HERE: GIT_NO_LAZY_FETCH.
#
# A mutant that removes the export survives this suite, and no fixture below
# changes that. Two reasons, both measured on this machine rather than
# assumed:
#   - git is 2.39.5. GIT_NO_LAZY_FETCH landed in 2.42, so the export is inert
#     here — removing a no-op cannot change an outcome.
#   - a promisor clone cannot be built locally either: `git clone
#     --filter=blob:none file://...` answers `filtering not recognized by
#     server, ignoring` and fetches every object, so there is no missing blob
#     for a capture to demand.
# orchestration.md already states this as a residual and not a guarantee. Said
# again here so the gap is visible from the suite that would otherwise be read
# as covering it.

# --- the capture does not rewrite the real index ---------------------------
#
# A diff against the WORKING TREE refreshes stale stat data and writes
# .git/index. That happens before the baseline snapshot exists, so it is a
# write nothing could disclose — the whole reason the recipe diffs through a
# copy. Stale mtimes on files whose CONTENT still matches are what gives the
# refresh something to write.
idxr="$(new_repo idxwrite)"
printf 'clean-a\n' > "${idxr}/clean-a.txt"
printf 'clean-b\n' > "${idxr}/clean-b.txt"
git -C "$idxr" add -A
git -C "$idxr" "${commit_env[@]}" commit -q -m clean
printf 'edit\n' >> "${idxr}/tracked.txt"
touch -m -t 202001010101 "${idxr}/clean-a.txt" "${idxr}/clean-b.txt" "${idxr}/tracked.txt"
idx_before="$(shasum -a 256 "${idxr}/.git/index" | cut -d' ' -f1)"
status="$(run_capture "$idxr" 'diff_args=(HEAD); untracked=1')"
idx_after="$(shasum -a 256 "${idxr}/.git/index" | cut -d' ' -f1)"
if [ "$status" = 0 ] && [ "$idx_before" = "$idx_after" ]; then
  ok "the capture does not rewrite .git/index"
else
  bad "the capture does not rewrite .git/index" "exit $status, index changed: $([ "$idx_before" = "$idx_after" ] && echo no || echo yes)"
fi

# --- programs the repository's own config names ----------------------------
#
# Phase 0 runs BEFORE the baseline snapshot exists, so anything it executes
# writes a repository nothing could yet disclose. Both of these are configured
# by the tree under review, which in an adversarial review is exactly the
# party that should not get to choose what runs.

cfg="$(new_repo configured)"
git -C "$cfg" add -A
git -C "$cfg" "${commit_env[@]}" commit -q -m base
printf 'edit\n' >> "${cfg}/tracked.txt"

# core.fsmonitor names a program git EXECUTES while refreshing the index.
fsm_marker="${WORK}/fsmonitor-fired"
cat > "${WORK}/fsmonitor-hook" <<HOOK
#!/bin/sh
: > "${fsm_marker}"
printf '/\0'
HOOK
chmod +x "${WORK}/fsmonitor-hook"
git -C "$cfg" config core.fsmonitor "${WORK}/fsmonitor-hook"

# diff.external replaces git's own diff machinery with a named program.
ext_marker="${WORK}/extdiff-fired"
cat > "${WORK}/ext-diff" <<HOOK
#!/bin/sh
: > "${ext_marker}"
exit 0
HOOK
chmod +x "${WORK}/ext-diff"
git -C "$cfg" config diff.external "${WORK}/ext-diff"

# A textconv driver is the third program the tree can name, and it is bound by
# .gitattributes rather than config alone — so a fixture that sets only config
# never reaches it. Beyond executing, it also REWRITES the diff into whatever
# prose it prints, and `git apply` cannot apply that: the captured patch would
# stop binding the change it claims to.
tc_marker="${WORK}/textconv-fired"
cat > "${WORK}/textconv" <<HOOK
#!/bin/sh
: > "${tc_marker}"
printf 'converted prose, not the bytes\n'
HOOK
chmod +x "${WORK}/textconv"
git -C "$cfg" config diff.owned.textconv "${WORK}/textconv"
printf '*.dat diff=owned\n' > "${cfg}/.gitattributes"
printf 'original\n' > "${cfg}/payload.dat"
git -C "$cfg" add .gitattributes payload.dat
git -C "$cfg" "${commit_env[@]}" commit -q -m attrs
printf 'changed\n' > "${cfg}/payload.dat"

rm -f "$fsm_marker" "$ext_marker" "$tc_marker"
status="$(run_capture "$cfg" 'diff_args=(HEAD); untracked=1')"
if [ "$status" = 0 ] && [ ! -e "$fsm_marker" ]; then
  ok "the capture does not run a configured fsmonitor program"
else
  bad "the capture does not run a configured fsmonitor program" "exit $status, fired: $([ -e "$fsm_marker" ] && echo yes || echo no)"
fi
if [ "$status" = 0 ] && [ ! -e "$ext_marker" ]; then
  ok "the capture does not run a configured diff.external program"
else
  bad "the capture does not run a configured diff.external program" "exit $status, fired: $([ -e "$ext_marker" ] && echo yes || echo no)"
fi
if [ "$status" = 0 ] && [ ! -e "$tc_marker" ]; then
  ok "the capture does not run a textconv driver named by .gitattributes"
else
  bad "the capture does not run a textconv driver named by .gitattributes" "exit $status, fired: $([ -e "$tc_marker" ] && echo yes || echo no)"
fi
# And the patch is still a real patch: an external differ that ran and was
# ignored would leave this empty, which would pass both checks above.
# shellcheck source=/dev/null
. "${WORK}/vars"
if [ -s "${tmp}/patch.diff" ] && grep -q 'tracked.txt' "${tmp}/patch.diff" &&
   grep -q '^+changed$' "${tmp}/patch.diff" &&
   ! grep -q 'converted prose' "${tmp}/patch.diff"; then
  ok "the capture still produces a real patch with all three programs configured"
else
  bad "the capture still produces a real patch with all three programs configured"
fi

# --- changed ranges, including the shapes the awk was written for ----------

rng="$(new_repo ranges)"
printf 'a\nb\nc\nd\ne\n' > "${rng}/edit.txt"
printf 'x\ny\nz\n' > "${rng}/gone.txt"
printf 'p\nq\nr\ns\n' > "${rng}/shrink.txt"
# A tracked path holding a non-ASCII byte. With git's default quotePath, the
# diff header comes out C-quoted as `+++ "b/caf\303\251.js"`, and the fixed
# substr then yields `/caf\303\251.js"` — a key no entry in included_paths
# has. The range is filed under a name nobody holds, the real file gets none,
# and every candidate in it drops silently to file-level binding.
printf 'u1\nu2\nu3\n' > "${rng}/café.js"
git -C "$rng" add -A
git -C "$rng" "${commit_env[@]}" commit -q -m ranges
printf 'a\nB\nc\nd\ne\n' > "${rng}/edit.txt"     # one changed line
rm "${rng}/gone.txt"                                  # wholly deleted file
printf 'p\ns\n' > "${rng}/shrink.txt"               # deletion-only hunk
printf 'u1\nCHANGED\nu3\n' > "${rng}/café.js"      # non-ASCII path, edited
printf 'brand\nnew\n' > "${rng}/fresh.txt"          # untracked, two lines
# The two shapes the untracked line count was written for. `wc -l` counts
# NEWLINES, so a file without a trailing one comes back 0 and the range
# becomes `1 0` — an explicit range that rejects every candidate in the file.
# And a genuinely empty file has no range at all: emitting `1 0` for it makes
# the whole run return invalid_args, where omitting it leaves the documented
# file-level fallback to cover the file.
printf 'no trailing newline' > "${rng}/nonl.txt"
: > "${rng}/empty.txt"
# And one that sorts LAST. `empty.txt` above is followed by two non-empty
# files, so the loop's final iteration succeeds and the body's status never
# becomes the pipeline's. With `zz-empty.txt` last, a `[ ] &&` body makes the
# whole `while` exit 1 and `set -euo pipefail` aborts Phase 0 — instead of
# quietly omitting the range, which is what the recipe's comment claims.
: > "${rng}/zz-empty.txt"
# An untracked file literally named `-`. Passed to awk as a bare operand it is
# STDIN — and stdin here is the NUL stream the enclosing `while` is reading
# from, so awk swallows every remaining record. Measured before the fix: the
# loop ran ONCE, emitted a bogus one-line range for `-`, and every untracked
# file after it got no range at all. `-` sorts first in `ls-files`, so the
# three assertions below it are the ones that catch the regression; this file
# needs its own range checked too, or a fix that merely SKIPS `-` would pass.
printf 'dash1\ndash2\n' > "${rng}/-"
# An ADDED source line reading `++ b/forged` is emitted as `+++ b/forged`,
# which is indistinguishable from a file header on its own. It has to be added
# by THIS change to appear at all under --unified=0, and a later hunk in the
# same file is what it would then capture: taken as a header, that hunk is
# filed under a path the artifact chose, and with an explicit range list every
# candidate outside it is rejected.
printf 'l1\nl2\nl3\nl4\nl5\nl6\n' > "${rng}/forge.txt"
# And the PAIRED shape, which a `saw_old` guard alone does not catch: one hunk
# rewriting `-- a/pairforged` into `++ b/pairforged` is emitted as a complete
# `--- a/... / +++ b/...` pair. It has to be an EDIT of an existing line, so
# the old side is committed here and changed below.
printf 'k1\n-- a/pairforged.txt\nk3\nk4\nk5\nk6\nk7\nk8\n' > "${rng}/pair.txt"
# A file added by this change: its header is `--- /dev/null`, so a rule keyed
# on `--- a/` skips the pair entirely and the hunk keeps the PREVIOUS file's
# name — losing this file's range and inventing one the other file never had.
git -C "$rng" add forge.txt pair.txt
git -C "$rng" "${commit_env[@]}" commit -q -m forge
printf 'l1\n++ b/forged.txt\nl2\nl3\nl4\nCHANGED\nl6\n' > "${rng}/forge.txt"
printf 'k1\n++ b/pairforged.txt\nk3\nk4\nk5\nk6\nk7\nLATER\n' > "${rng}/pair.txt"
printf 'add1\nadd2\nadd3\n' > "${rng}/added.txt"
git -C "$rng" add added.txt
rng_out="${WORK}/ranges.out"
rng_status=0
(
  cd "$rng" || exit 1
  set -euo pipefail
  diff_args=(HEAD); untracked=1; excludes=(':(exclude)no-such-path-zzz')
  # shellcheck source=/dev/null
  . "${WORK}/ranges.sh"
) > "$rng_out" 2>/dev/null || rng_status=$?

check_range() {
  if grep -qE "^$1\$" "$rng_out"; then ok "changed ranges: $2"; else bad "changed ranges: $2" "$(tr '\n' '|' < "$rng_out")"; fi
}
if [ "$rng_status" != 0 ]; then
  bad "the changed-range recipe runs" "exit $rng_status"
else
  ok "the changed-range recipe runs"
  check_range 'edit\.txt 2 2' 'a one-line edit'
  # A deletion-only hunk has new-side length 0; it anchors where the deletion
  # sits rather than being dropped.
  # The exact range, not `[0-9]+ [0-9]+`. The shape form accepted
  # `shrink.txt 999 999` — an explicit range that rejects every candidate in
  # the hunk — which is the same defect the assertion exists to catch.
  check_range 'shrink\.txt 1 1' 'a deletion-only hunk anchors where the deletion sits'
  # A wholly deleted file takes its span from the OLD side, under the OLD
  # path — the new side is /dev/null.
  check_range 'gone\.txt 1 3' 'a wholly deleted file'
  check_range 'fresh\.txt 1 2' 'an untracked file, in its entirety'
  # Keyed by the LITERAL path, which is what included_paths carries.
  check_range 'café\.js 2 2' 'a tracked path holding a non-ASCII byte'
  check_range 'nonl\.txt 1 1' 'an untracked file with no trailing newline'
  check_range '- 1 2' 'an untracked file literally named -'
  if grep -q '^zz-empty\.txt ' "$rng_out"; then
    bad "changed ranges: an empty untracked file sorting LAST gets no range" "$(grep '^zz-empty\.txt ' "$rng_out")"
  else
    ok "changed ranges: an empty untracked file sorting LAST gets no range"
  fi
  if grep -q '^empty\.txt ' "$rng_out"; then
    bad "changed ranges: an empty untracked file gets no range at all" "$(grep '^empty\.txt ' "$rng_out")"
  else
    ok "changed ranges: an empty untracked file gets no range at all"
  fi
  # Both halves: no range under the forged path, and the later hunk still
  # filed under the real one.
  if grep -q '^forged\.txt ' "$rng_out"; then
    bad "changed ranges: a forged +++ line is not a header" "$(tr '\n' '|' < "$rng_out")"
  elif ! grep -qE '^forge\.txt 6 6$' "$rng_out"; then
    bad "changed ranges: the hunk after a forged +++ keeps its real path" "$(tr '\n' '|' < "$rng_out")"
  else
    ok "changed ranges: a forged +++ line is not a header"
  fi
  # The paired shape. Same two halves: nothing under the forged path, and the
  # later hunk still under the real one.
  if grep -q '^pairforged\.txt ' "$rng_out"; then
    bad "changed ranges: a forged --- +++ PAIR is not a header" "$(tr '\n' '|' < "$rng_out")"
  elif ! grep -qE '^pair\.txt 8 8$' "$rng_out"; then
    bad "changed ranges: the hunk after a forged pair keeps its real path" "$(tr '\n' '|' < "$rng_out")"
  else
    ok "changed ranges: a forged --- +++ pair is not a header"
  fi
  # A newly added file gets its OWN range, and no range is invented for
  # whichever file the diff happened to emit before it.
  check_range 'added\.txt 1 3' 'a newly added tracked file'
fi

# The SAME recipe with untracked=0 — every branch and explicit-range scope.
# Nothing exercised this before: the block ended in `[ "${untracked}" = 1 ] &&
# pipeline`, whose status with a false test is 1, and as the last statement of
# a Phase 0 Bash call that is the CALL's exit status. The tracked ranges above
# it were produced correctly and the step still reported failure.
rng0_out="${WORK}/ranges-untracked0.out"
rng0_status=0
(
  cd "$rng" || exit 1
  set -euo pipefail
  diff_args=(HEAD); untracked=0; excludes=(':(exclude)no-such-path-zzz')
  # shellcheck source=/dev/null
  . "${WORK}/ranges.sh"
) > "$rng0_out" 2>/dev/null || rng0_status=$?
if [ "$rng0_status" != 0 ]; then
  bad "the changed-range recipe succeeds with untracked=0" "exit $rng0_status"
elif ! grep -qE '^edit\.txt 2 2$' "$rng0_out"; then
  # Exit 0 alone is satisfied by a block that produces nothing, so the tracked
  # half has to still be there.
  bad "the changed-range recipe succeeds with untracked=0" "exit 0 but no tracked ranges: $(tr '\n' '|' < "$rng0_out")"
elif grep -q '^fresh\.txt ' "$rng0_out"; then
  bad "the changed-range recipe succeeds with untracked=0" "untracked ranges were emitted anyway"
else
  ok "the changed-range recipe succeeds with untracked=0"
fi

echo
echo "${pass} passed, ${fail} failed"
[ "$fail" -eq 0 ]
