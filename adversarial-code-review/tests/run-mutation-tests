echo
# A `mutate` line whose arguments fail to expand never reaches the function,
# so neither counter moves and the run still prints success. That is the
# manufactured confidence this script exists to catch, one level up again.
# Pin the count: any mutant that silently fails to launch is now a failure.
EXPECTED_TOTAL=124
if [ "${total}" -ne "${EXPECTED_TOTAL}" ]; then
  echo "expected ${EXPECTED_TOTAL} mutants, ran ${total} — a mutate line failed before it could run"
  exit 1
fi
