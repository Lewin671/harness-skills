#!/usr/bin/env bash
# Do the contract tests actually bite?
#
# A green suite proves nothing on its own — an assertion that can never fail
# is worse than no assertion, because it manufactures confidence. This breaks
# one protection in review-workflow.js at a time, on a COPY, and requires
# run-tests to go red for each. A surviving mutant means that protection is
# unguarded: either add a scenario that reaches it, or an assertion that sees
# the difference.
#
# Exit 0 when every mutant is killed. Known-equivalent mutants are listed and
# excluded explicitly rather than silently tolerated.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ORIG="${HERE}/../review-workflow.js"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/acr-mut-XXXXXX")"
trap 'rm -rf "${TMP}"' EXIT

# A red baseline would make every mutant look killed for free — the same
# can't-fail-meaningfully defect this script exists to catch, one level up.
if ! "${HERE}/run-tests" >/dev/null 2>&1; then
  echo "baseline run-tests is already failing — fix that first; mutation results would be meaningless"
  exit 1
fi

survived=0
total=0

mutate() {
  local name="$1" from="$2" to="$3" nth="${4:-1}"
  total=$((total + 1))
  if ! ACR_FROM="$from" ACR_TO="$to" ACR_NTH="$nth" ACR_SRC="$ORIG" ACR_OUT="${TMP}/m.js" python3 - <<'PY'
import os, pathlib, sys
s = pathlib.Path(os.environ['ACR_SRC']).read_text()
frm, to, nth = os.environ['ACR_FROM'], os.environ['ACR_TO'], int(os.environ['ACR_NTH'])
if s.count(frm) < nth:
    sys.exit(9)
i = -1
for _ in range(nth):
    i = s.index(frm, i + 1)
pathlib.Path(os.environ['ACR_OUT']).write_text(s[:i] + to + s[i + len(frm):])
PY
  then
    printf '%-44s %s\n' "$name" "SKIP (target text not found — update this mutant)"
    survived=$((survived + 1))
    return
  fi
  if ACR_WORKFLOW="${TMP}/m.js" "${HERE}/run-tests" >/dev/null 2>&1; then
    printf '%-44s %s\n' "$name" "SURVIVED"
    survived=$((survived + 1))
  else
    printf '%-44s %s\n' "$name" "killed"
  fi
}

