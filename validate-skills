#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

ruby - "${repo_root}" <<'RUBY'
require "yaml"

repo_root = ARGV.fetch(0)
skill_files = Dir.glob(File.join(repo_root, "*", "SKILL.md")).sort
errors = []

KNOWN_HARNESSES = %w[claude-code codex kiro].freeze
ONLY_DESCRIPTION_HARNESS = {
  /claude\s+code\s+only/i => "claude-code",
  /codex\s+only/i => "codex",
  /kiro\s+only/i => "kiro",
}.freeze

skill_files.each do |path|
  relative = path.delete_prefix("#{repo_root}/")
  content = File.read(path)
  lines = content.lines

  unless lines.first&.match?(/\A---\s*\z/)
    errors << "#{relative}: missing opening frontmatter delimiter"
    next
  end

  closing_index = lines[1..]&.find_index { |line| line.match?(/\A---\s*\z/) }
  unless closing_index
    errors << "#{relative}: missing closing frontmatter delimiter"
    next
  end

  yaml_text = lines[1, closing_index + 1].join
  metadata = YAML.safe_load(yaml_text, permitted_classes: [], aliases: false)

  unless metadata.is_a?(Hash)
    errors << "#{relative}: frontmatter must be a YAML mapping"
    next
  end

  name = metadata["name"]
  description = metadata["description"]
  skill_dir = File.basename(File.dirname(path))

  unless name.is_a?(String) && !name.strip.empty?
    errors << "#{relative}: frontmatter name must be a non-empty string"
  end

  unless description.is_a?(String) && !description.strip.empty?
    errors << "#{relative}: frontmatter description must be a non-empty string"
  end

  if name.is_a?(String) && name != skill_dir
    errors << "#{relative}: frontmatter name #{name.inspect} must match directory #{skill_dir.inspect}"
  end

  harnesses = metadata["harnesses"]
  if metadata.key?("harnesses")
    if !harnesses.is_a?(Array) || harnesses.empty? || harnesses.any? { |h| !KNOWN_HARNESSES.include?(h) }
      errors << "#{relative}: frontmatter harnesses must be a non-empty array drawn from #{KNOWN_HARNESSES.inspect}, got #{harnesses.inspect}"
    end
  end

  if description.is_a?(String)
    ONLY_DESCRIPTION_HARNESS.each do |pattern, harness|
      next unless description.match?(pattern)

      unless harnesses.is_a?(Array) && harnesses == [harness]
        errors << "#{relative}: description declares #{harness.inspect} ONLY, so frontmatter must set harnesses: [#{harness}] (got #{harnesses.inspect}) — the linker only enforces the gate via this key"
      end
    end
  end
rescue Psych::SyntaxError => e
  errors << "#{relative}: invalid YAML: #{e.problem} at line #{e.line} column #{e.column}"
rescue Psych::Exception => e
  errors << "#{relative}: invalid YAML: #{e.message}"
end

# AGENTS.md: Claude Code substitutes bare $1-style tokens with invocation
# arguments when it renders skill content, so one in a shell recipe is silently
# rewritten before an agent ever runs it. The rule was stated and enforced by
# nothing; two of them reached a documented, executable Phase 0 command.
#
# Everything an agent reads counts, not only SKILL.md — the references are
# loaded the same way. Binary files and the tests are skipped: tests are run
# by the shell, never rendered.
skill_files.each do |skill_path|
  dir = File.dirname(skill_path)
  Dir.glob(File.join(dir, "**", "*")).sort.each do |path|
    next unless File.file?(path)
    next if path.include?("/tests/")
    next unless path.end_with?(".md")

    File.readlines(path).each_with_index do |line, i|
      # `$(1)` and `${1}` are the escaped spellings this repo uses on purpose.
      scrubbed = line.gsub(/\$\(/, "").gsub(/\$\{/, "")
      next unless scrubbed.match?(/\$\d/)

      errors << "#{path.delete_prefix("#{repo_root}/")}:#{i + 1}: bare $-digit token; Claude Code substitutes it with an invocation argument at render time — write $(1) or ${1}"
    end
  end
end

if errors.empty?
  puts "ok #{skill_files.length} skills"
else
  warn errors.join("\n")
  exit 1
end
RUBY
