function run(command, args, cwd) {
  return new Promise((resolve) => {
    const child = spawn(command, args, { cwd, stdio: 'ignore', env: process.env })
    child.on('error', () => resolve(127))
    child.on('close', (code) => resolve(code ?? 1))
  })
}

async function evaluate(mutant, index) {
  const [name, relative, from, to] = mutant
  const work = join(root, `mutant-${index}`)
  cpSync(skill, work, { recursive: true })
  const file = join(work, relative)
  const source = readFileSync(file, 'utf8')
  if (!source.includes(from)) return { name, verdict: 'INVALID: target text not found' }
  writeFileSync(file, source.replace(from, to))
  if (await run(process.execPath, ['--check', file], work) !== 0) return { name, verdict: 'INVALID: mutant does not parse' }
  const status = await run(process.execPath, ['--test', join(work, 'tests/unit.test.mjs')], work)
  return { name, verdict: status === 0 ? 'SURVIVED' : 'killed' }
}

async function main() {
  const baseline = await run(process.execPath, ['--test', join(skill, 'tests/unit.test.mjs')], skill)
  if (baseline !== 0) {
    process.stderr.write('baseline unit tests are failing; mutation results would be meaningless\n')
    process.exitCode = 1
    return
  }

  const results = new Array(mutants.length)
  let cursor = 0
  async function worker() {
    for (;;) {
      const index = cursor++
      if (index >= mutants.length) return
      results[index] = await evaluate(mutants[index], index)
    }
  }
  await Promise.all(Array.from({ length: Math.min(maxJobs, mutants.length) }, worker))

  let failed = 0
  for (const result of results) {
    process.stdout.write(`${result.name.padEnd(48)} ${result.verdict}\n`)
    if (result.verdict !== 'killed') failed += 1
  }
  process.stdout.write(`\n${mutants.length - failed}/${mutants.length} mutants killed\n`)
  process.exitCode = failed ? 1 : 0
}

try {
  await main()
} finally {
  rmSync(root, { recursive: true, force: true })
}
