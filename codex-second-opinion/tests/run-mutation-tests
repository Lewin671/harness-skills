#!/usr/bin/env node

import { cpSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { spawn } from 'node:child_process'

const here = dirname(fileURLToPath(import.meta.url))
const skill = dirname(here)
const root = mkdtempSync(join(tmpdir(), 'cso-mutation-'))
const maxJobs = Math.max(1, Number(process.env.CSO_MUTATION_JOBS || 8))

const mutants = [
  ['sandbox stays read-only', 'lib/runtime.mjs', `'sandbox_mode="read-only"'`, `'sandbox_mode="workspace-write"'`],
  ['hooks stay disabled', 'lib/runtime.mjs', `'--disable', 'hooks', '--disable', 'apps'`, `'--disable', 'apps'`],
  ['plugins stay disabled', 'lib/runtime.mjs', `'--disable', 'apps', '--disable', 'plugins'`, `'--disable', 'apps'`],
  ['notify callback stays cleared', 'lib/runtime.mjs', `'-c', 'notify=[]'`, `'-c', 'notify=["unsafe"]'`],
  ['strict config stays enabled', 'lib/runtime.mjs', `'--strict-config',`, ``],
  ['failed feature output is discarded', 'lib/environment.mjs', `featureText = ''`, `featureText = features.stdout`],
  ['MCP root must be an array', 'lib/mcp.mjs', `if (!Array.isArray(value)) {`, `if (false) {`],
  ['MCP entries must be objects', 'lib/mcp.mjs', `if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {`, `if (false) {`],
  ['MCP enabled field is required', 'lib/mcp.mjs', `if (!Object.hasOwn(entry, 'enabled')) {`, `if (false) {`],
  ['MCP enabled field is boolean', 'lib/mcp.mjs', `if (typeof entry.enabled !== 'boolean') {`, `if (false) {`],
  ['enabled MCP entries need names', 'lib/mcp.mjs', `if (entry.enabled && typeof entry.name !== 'string') {`, `if (false) {`],
  ['model needs effort', 'lib/runtime.mjs', `if (state.modelSet && !state.effortSet) {`, `if (false) {`],
  ['effort needs model', 'lib/runtime.mjs', `if (state.effortSet && !state.modelSet) {`, `if (false) {`],
  ['inherit cannot mix with explicit flags', 'lib/runtime.mjs', `if (state.inheritSet && (state.modelSet || state.effortSet)) {`, `if (false) {`],
  ['repeated model flags are rejected', 'lib/runtime.mjs', `if (state.modelSet > 1 || state.effortSet > 1 || state.inheritSet > 1) {`, `if (false) {`],
  ['event metadata comes from last attempt', 'lib/runtime.mjs', `log.lastIndexOf(\`${'${ATTEMPT_MARKER}'}\\n\`)`, `log.indexOf(\`${'${ATTEMPT_MARKER}'}\\n\`)`],
  ['fallback resumes with inherited settings', 'lib/runtime.mjs', `if (state.usedFallback || !state.model) return ' --inherit'`, `if (!state.model) return ' --inherit'`],
  ['context fence cannot close early', 'lib/review.mjs', `review.context.replaceAll(CONTEXT_FENCE, \`${'${CONTEXT_FENCE}'}-ESCAPED\`)`, `review.context`],
  ['UUID continuation remains strict', 'lib/consult.mjs', `if (!UUID.test(value)) {`, `if (false) {`],
  ['symlink components resolve before dot-dot', 'lib/environment.mjs', `if (part === '..') { current = dirname(current); continue }`, `if (part === '..') { continue }`],
  ['rejected-model detection stays scoped to structured events', 'lib/runtime.mjs', `if (event?.type !== 'error' && event?.type !== 'turn.failed') continue`, `if (false) continue`],
]

function run(command, args, cwd) {
  return new Promise((resolve) => {
    const child = spawn(command, args, { cwd, stdio: 'ignore', env: process.env })
    child.on('error', () => resolve(127))
    child.on('close', (code) => resolve(code ?? 1))
  })
}

async function evaluate(mutant, index) {
  const [name, relative, from, to] = mutant
  const work = join(root, `mutant-${index}`)
  cpSync(skill, work, { recursive: true })
  const file = join(work, relative)
  const source = readFileSync(file, 'utf8')
  if (!source.includes(from)) return { name, verdict: 'INVALID: target text not found' }
  writeFileSync(file, source.replace(from, to))
  if (await run(process.execPath, ['--check', file], work) !== 0) return { name, verdict: 'INVALID: mutant does not parse' }
  const status = await run(process.execPath, ['--test', join(work, 'tests/unit.test.mjs')], work)
  return { name, verdict: status === 0 ? 'SURVIVED' : 'killed' }
}

async function main() {
  const baseline = await run(process.execPath, ['--test', join(skill, 'tests/unit.test.mjs')], skill)
  if (baseline !== 0) {
    process.stderr.write('baseline unit tests are failing; mutation results would be meaningless\n')
    process.exitCode = 1
    return
  }

  const results = new Array(mutants.length)
  let cursor = 0
  async function worker() {
    for (;;) {
      const index = cursor++
      if (index >= mutants.length) return
      results[index] = await evaluate(mutants[index], index)
    }
  }
  await Promise.all(Array.from({ length: Math.min(maxJobs, mutants.length) }, worker))

  let failed = 0
  for (const result of results) {
    process.stdout.write(`${result.name.padEnd(48)} ${result.verdict}\n`)
    if (result.verdict !== 'killed') failed += 1
  }
  process.stdout.write(`\n${mutants.length - failed}/${mutants.length} mutants killed\n`)
  process.exitCode = failed ? 1 : 0
}

try {
  await main()
} finally {
  rmSync(root, { recursive: true, force: true })
}
