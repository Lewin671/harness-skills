#!/usr/bin/env bash
# Read-only second opinions from OpenAI's Codex, in two modes:
#
#   review   run `codex exec review` over a code change
#   consult  ask a free-form question answered with the repo as context
#
# Prints the result Markdown to stdout; diagnostics go to stderr.
#
# Exit codes carry the meaning that Codex's own exit code does not:
#   0  a result was produced
#   2  (review only) nothing in scope — Codex was never invoked
#   3  environment problem (no codex, not a git repo, bad arguments)
#   4  codex ran but failed
#   5  hung past --timeout and was killed
set -euo pipefail
# An exported CDPATH would make the `cd "$repo"` in the shared runtime
# resolve a slashless --repo through other directories — running against
# a same-named wrong tree — and echo the resolved path onto stdout,
# which must carry nothing but the result. It would corrupt the
# $(cd ...) substitutions the same way.
unset CDPATH
# `--repo` is supposed to select the repository, and on its own it does not:
# every git call below inherits these. Measured — with the requested directory
# as GIT_WORK_TREE and ANOTHER repository's .git as GIT_DIR,
# `--is-inside-work-tree` says true and `--show-toplevel` returns the
# requested directory, while `git status` compares it against the other
# repository's index and history. The prechecks, the scope resolution and the
# repo-containment tests would all describe the wrong tree, with no error.
# Codex is launched with the same environment, so it would read it too.
# GIT_INDEX_FILE is unset here and set deliberately, per command, by
# git_readonly_index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE \
      GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM

# Resolve the physical directory so the lib/ files are found through
# the symlink the skill linker installs.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

top_usage() {
  # printf, not a heredoc: on bash 3.2 a heredoc is materialised under
  # TMPDIR, so usage text — including --help — depended on that being
  # writable, and this runs BEFORE the scratch relocation. Reported as
  # exiting 1 instead of 0 (or 3) on a read-only filesystem.
  printf '%s\n' 'Usage: run-codex-second-opinion <review|consult> [ARGS]

  review   run `codex exec review` over a code change
  consult  ask a free-form question answered with the repo as context

Run `run-codex-second-opinion <mode> --help` for that mode'\''s arguments.

Environment:
  CODEX_BIN                     path to the codex binary (default: codex)
  CODEX_SECOND_OPINION_MODEL    override the pinned default model
  CODEX_SECOND_OPINION_EFFORT   override the pinned default effort
  CODEX_SECOND_OPINION_TIMEOUT  override the default timeout (seconds)' >&2
}

mode="${1:-}"
case "$mode" in
  review|consult) shift ;;
  -h|--help) top_usage; exit 0 ;;
  '')
    echo "error: a mode is required" >&2
    top_usage
    exit 3 ;;
  *)
    # Flattened before printing. This is the FIRST thing written to stderr and
    # it happens before any validation, so a mode argument carrying a newline
    # emitted a standalone `report:` line of its own — and an invalid
    # invocation produces no genuine marker afterwards, so the forged one is
    # the final line of its kind that a merged-stream reader is told to trust.
    # Measured.
    echo "error: unknown mode: $(printf '%s' "${mode}" | tr '\r\n' '  ')" >&2
    top_usage
    exit 3 ;;
esac

# shellcheck source=lib/common.bash
source "${script_dir}/lib/common.bash"
# shellcheck source=/dev/null
source "${script_dir}/lib/${mode}.bash"

mode_main "$@"
