#!/bin/sh
set -euf

# run-codex-second-opinion.mjs (this script's sibling) does the real work,
# but is launched here with an explicit `node` rather than executed
# directly via its own #!/usr/bin/env node shebang: an env shebang
# resolves `node` via the full, unfiltered PATH before a single line of
# this project's own JavaScript -- including its PATH sanitization for
# every child it spawns -- has run. A relative PATH entry there, with cwd
# already inside the repository under review, could substitute a
# repository-supplied `node` before any of that hardening exists. See
# references/internals.md, "Codex binary trust boundary", point 7.
#
# /bin/sh itself needs no PATH search -- the shebang above names it by an
# absolute, POSIX-guaranteed path -- so PATH can be filtered here, in
# nothing but shell built-ins, before anything (including `node`) is
# looked up by name. `-f` (noglob, part of `set -euf` above) matters here
# specifically: an unquoted $PATH expansion undergoes pathname expansion as
# well as the field-splitting IFS=: enables, so a component containing a
# glob character (`/opt/*`, say) would otherwise expand to every matching
# directory -- entries the literal PATH value never actually named --
# before this loop ever gets to filter them. Verified empirically.
# Absolute is necessary but NOT sufficient. The dev-tooling case this
# bootstrap exists for -- direnv, asdf, mise -- prepends an entry that is
# usually absolute and *inside the project*: `PATH_add bin` exports
# `/repo/bin`, and `layout node` exports `/repo/node_modules/.bin`. Such an
# entry sailed through an absolute-only filter and could then supply the very
# `node` this script is about to exec, from the repository under review,
# before a line of the project's own JavaScript runs. Verified empirically: a
# `/repo/bin/node` on an absolute repo-internal PATH entry was executed.
#
# So entries under the launch directory are dropped too, as are entries under
# an explicit `--repo` target when one is given -- an agent may run this from
# elsewhere and point it at the repository. Each candidate is compared by its
# PHYSICAL location (`cd` + `pwd -P` in a subshell), so a symlink into the
# repository is caught as readily as a literal path. Both are shell built-ins:
# nothing has to be found on PATH to run this filter, which is the whole
# reason the filter can run before PATH is trusted.
# Both directories are widened to their REPOSITORY ROOT first. Filtering
# against the launch directory alone protected only that directory: run from
# /repo/sub, or with `--repo /repo/sub`, and an absolute /repo/bin entry
# survived untouched and could still supply `node`. The root is found by
# walking up for a `.git` entry -- a file as well as a directory, since a
# worktree or submodule checkout uses a gitfile -- which needs no `git` binary,
# and must not, because choosing a trustworthy PATH is the very thing that has
# to happen before anything is looked up on it.
repo_root_of() {
  d=$1
  while [ -n "$d" ]; do
    if [ -e "$d/.git" ]; then printf '%s' "$d"; return 0; fi
    case $d in
      /) break ;;
    esac
    d=${d%/*}
    [ -z "$d" ] && d=/
  done
  return 1
}

launch_dir=$(pwd -P)
launch_dir=$(repo_root_of "$launch_dir") || launch_dir=$(pwd -P)

unset CDPATH 2>/dev/null || true

repo_dir=
skip_next=false
prev=
for arg do
  if $skip_next; then skip_next=false; prev=; continue; fi
  case $prev in
    --repo) repo_dir=$arg; prev=; continue ;;
  esac
  case $arg in --) break ;; esac
  case $arg in
    --model|--effort|--base|--commit|--custom|--context|--timeout|--continue)
      skip_next=true ;;
  esac
  prev=$arg
done
if [ -n "$repo_dir" ]; then
  repo_dir=$(cd -- "$repo_dir" 2>/dev/null && pwd -P) || repo_dir=
  if [ -n "$repo_dir" ]; then
    repo_dir=$(repo_root_of "$repo_dir") || repo_dir=$(cd -- "$repo_dir" && pwd -P)
  fi
fi

inside_repo() {
  case $1 in
    "$launch_dir"|"$launch_dir"/*) return 0 ;;
  esac
  if [ -n "$repo_dir" ]; then
    case $1 in
      "$repo_dir"|"$repo_dir"/*) return 0 ;;
    esac
  fi
  return 1
}

safe_path=
dropped=0
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  case $dir in
    /*) ;;
    *) continue ;;
  esac
  # An entry that cannot be entered is dropped silently: `cd` needs the same
  # execute bit a PATH search does, so such an entry could never have supplied
  # a binary anyway, and a stale `~/bin` on PATH is too ordinary to warn about.
  # Only a repository-internal entry -- the thing this filter exists to catch
  # -- is worth a line on stderr.
  real_dir=$(cd -- "$dir" 2>/dev/null && pwd -P) || continue
  if inside_repo "$real_dir"; then
    dropped=$((dropped + 1))
    continue
  fi
  safe_path=${safe_path:+$safe_path:}$dir
done
IFS=$old_ifs

if [ "$dropped" -gt 0 ]; then
  echo "note: dropped $dropped PATH entry/entries that resolve inside the repository under review" >&2
fi

# An empty PATH is not "search nothing": POSIX command lookup treats an
# empty PATH (and an empty component within one) as the current directory,
# so exporting PATH= here would silently reopen the exact cwd-relative
# lookup this bootstrap exists to close -- verified empirically
# (`env -i PATH= /bin/sh -c 'exec node --version'` runs a `./node` placed in
# cwd). Refuse instead of handing `node` a lookup rule that means "cwd".
if [ -z "$safe_path" ]; then
  echo "error: no absolute PATH entry remains after filtering; refusing rather than falling back to the current directory, which an empty PATH means under POSIX lookup rules." >&2
  echo "hint: set PATH to include the absolute directory that contains node before running this script." >&2
  exit 3
fi
PATH=$safe_path
export PATH

# Without this, a filtered PATH that simply has no `node` on it reaches the
# `exec` below and dies with the shell's own diagnostic and status 127 -- a
# code this skill does not document, from a message that does not say what to
# do about it. `command -v` is a built-in, so it needs nothing on PATH itself.
if ! command -v node >/dev/null 2>&1; then
  echo "error: no 'node' found on the PATH that remains after repository-internal entries were removed." >&2
  echo "error: this script needs Node.js 18 or newer to run." >&2
  echo "hint: install Node.js, or put the absolute directory containing it on PATH from outside the repository under review." >&2
  exit 3
fi

# Neutralize Node startup variables that can preload code or write files
# before the .mjs entry point's own baseEnv sanitization takes effect.
# Dynamic-loader variables (LD_PRELOAD, DYLD_*) can affect /bin/sh itself
# and are outside this script's reach; this closes the Node-specific channels.
unset NODE_OPTIONS NODE_PATH NODE_V8_COVERAGE NODE_COMPILE_CACHE NODE_REDIRECT_WARNINGS 2>/dev/null || true

# Resolve node once and reuse the resolved path for both the version check
# and the final exec, so the same binary is tested and run.
node_bin=$(command -v node)
if ! "$node_bin" -e 'process.exit(Number(process.versions.node.split(".")[0]) < 18 ? 1 : 0)' 2>/dev/null; then
  echo "error: Node.js 18 or newer is required; the 'node' on PATH is too old or broken." >&2
  echo "hint: install a current Node.js, or put its directory on PATH." >&2
  exit 3
fi

case $0 in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac

exec "$node_bin" "$script_dir/run-codex-second-opinion.mjs" "$@"
