#!/bin/sh
set -euf

# run-codex-second-opinion.mjs (this script's sibling) does the real work,
# but is launched here with an explicit `node` rather than executed
# directly via its own #!/usr/bin/env node shebang: an env shebang
# resolves `node` via the full, unfiltered PATH before a single line of
# this project's own JavaScript -- including its PATH sanitization for
# every child it spawns -- has run. A relative PATH entry there, with cwd
# already inside the repository under review, could substitute a
# repository-supplied `node` before any of that hardening exists. See
# references/internals.md, "Codex binary trust boundary", point 7.
#
# /bin/sh itself needs no PATH search -- the shebang above names it by an
# absolute, POSIX-guaranteed path -- so PATH can be filtered here, in
# nothing but shell built-ins, before anything (including `node`) is
# looked up by name. `-f` (noglob, part of `set -euf` above) matters here
# specifically: an unquoted $PATH expansion undergoes pathname expansion as
# well as the field-splitting IFS=: enables, so a component containing a
# glob character (`/opt/*`, say) would otherwise expand to every matching
# directory -- entries the literal PATH value never actually named --
# before this loop ever gets to filter them. Verified empirically.
safe_path=
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  case $dir in
    /*) safe_path=${safe_path:+$safe_path:}$dir ;;
  esac
done
IFS=$old_ifs

# An empty PATH is not "search nothing": POSIX command lookup treats an
# empty PATH (and an empty component within one) as the current directory,
# so exporting PATH= here would silently reopen the exact cwd-relative
# lookup this bootstrap exists to close -- verified empirically
# (`env -i PATH= /bin/sh -c 'exec node --version'` runs a `./node` placed in
# cwd). Refuse instead of handing `node` a lookup rule that means "cwd".
if [ -z "$safe_path" ]; then
  echo "error: no absolute PATH entry remains after filtering; refusing rather than falling back to the current directory, which an empty PATH means under POSIX lookup rules." >&2
  echo "hint: set PATH to include the absolute directory that contains node before running this script." >&2
  exit 3
fi
PATH=$safe_path
export PATH

case $0 in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac

exec node "$script_dir/run-codex-second-opinion.mjs" "$@"
