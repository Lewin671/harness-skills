#!/bin/sh
set -euf

# run-codex-second-opinion.mjs (this script's sibling) does the real work,
# but is launched here with an explicit `node` rather than executed
# directly via its own #!/usr/bin/env node shebang: an env shebang
# resolves `node` via the full, unfiltered PATH before a single line of
# this project's own JavaScript -- including its PATH sanitization for
# every child it spawns -- has run. A relative PATH entry there, with cwd
# already inside the repository under review, could substitute a
# repository-supplied `node` before any of that hardening exists. See
# references/internals.md, "Codex binary trust boundary", point 7.
#
# /bin/sh itself needs no PATH search -- the shebang above names it by an
# absolute, POSIX-guaranteed path -- so PATH can be filtered here, in
# nothing but shell built-ins, before anything (including `node`) is
# looked up by name. `-f` (noglob, part of `set -euf` above) matters here
# specifically: an unquoted $PATH expansion undergoes pathname expansion as
# well as the field-splitting IFS=: enables, so a component containing a
# glob character (`/opt/*`, say) would otherwise expand to every matching
# directory -- entries the literal PATH value never actually named --
# before this loop ever gets to filter them. Verified empirically.
# Absolute is necessary but NOT sufficient. The dev-tooling case this
# bootstrap exists for -- direnv, asdf, mise -- prepends an entry that is
# usually absolute and *inside the project*: `PATH_add bin` exports
# `/repo/bin`, and `layout node` exports `/repo/node_modules/.bin`. Such an
# entry sailed through an absolute-only filter and could then supply the very
# `node` this script is about to exec, from the repository under review,
# before a line of the project's own JavaScript runs. Verified empirically: a
# `/repo/bin/node` on an absolute repo-internal PATH entry was executed.
#
# So entries under the launch directory are dropped too, as are entries under
# an explicit `--repo` target when one is given -- an agent may run this from
# elsewhere and point it at the repository. Each candidate is compared by its
# PHYSICAL location (`cd` + `pwd -P` in a subshell), so a symlink into the
# repository is caught as readily as a literal path. Both are shell built-ins:
# nothing has to be found on PATH to run this filter, which is the whole
# reason the filter can run before PATH is trusted.
# Both directories are widened to their REPOSITORY ROOT first. Filtering
# against the launch directory alone protected only that directory: run from
# /repo/sub, or with `--repo /repo/sub`, and an absolute /repo/bin entry
# survived untouched and could still supply `node`. The root is found by
# walking up for a `.git` entry -- a file as well as a directory, since a
# worktree or submodule checkout uses a gitfile -- which needs no `git` binary,
# and must not, because choosing a trustworthy PATH is the very thing that has
# to happen before anything is looked up on it.
# Both helpers below return through a variable instead of stdout. Returning a
# PATHNAME through `$(...)` is not safe here: command substitution strips
# every trailing newline from what it captures, and a directory name is
# allowed to end in one. `pwd -P` inside a substitution therefore reports
# `/a/evil<LF>` as `/a/evil`, and the filter then compares a PATH entry that
# really is `/a/evil<LF>/bin` against a root spelled `/a/evil` -- no match, so
# the entry survives and can supply `node` out of the repository the caller
# named. Verified empirically: a `node` under a repository root whose name
# ends in LF executed. Avoiding the substitution avoids the truncation
# outright, and it removes the last `printf` from the phase that runs before
# PATH is filtered, where nothing external may be looked up.
nl='
'

# Result in $_root_result. Walks up for a `.git` entry -- a file as well as a
# directory, since a worktree or submodule checkout uses a gitfile -- which
# needs no `git` binary, and must not, because choosing a trustworthy PATH is
# the very thing that has to happen before anything is looked up on it.
# Returns 1 when no enclosing repository exists, leaving the caller to decide
# the fallback rather than inventing one here.
repo_root_of() {
  d=$1
  while [ -n "$d" ]; do
    if [ -e "$d/.git" ]; then _root_result=$d; return 0; fi
    case $d in
      /) break ;;
    esac
    d=${d%/*}
    [ -z "$d" ] && d=/
  done
  return 1
}

# Result in $_phys_result: the physical location of $1, with a trailing
# newline in the pathname preserved. The `echo .` sentinel is what preserves
# it -- it makes `pwd`'s output no longer trailing, so the substitution's
# stripping consumes the sentinel's own newline instead of the pathname's.
# What is left is then peeled back exactly: the `.`, then the single newline
# `pwd` itself terminates its output with. Returns 1 when $1 cannot be
# entered, which every caller treats the same way it already treated a failed
# `cd`. `cd`, `pwd` and `echo` are all shell built-ins, so this needs nothing
# on PATH -- the whole reason the filter can run before PATH is trusted.
physical_dir() {
  _phys=$(cd -- "$1" 2>/dev/null && pwd -P && echo .) || return 1
  _phys=${_phys%.}
  _phys_result=${_phys%"$nl"}
}

physical_dir "." || {
  echo "error: the current directory could not be resolved; refusing to choose a PATH without knowing where this is running from." >&2
  exit 3
}
launch_dir=$_phys_result
if repo_root_of "$launch_dir"; then launch_dir=$_root_result; fi

unset CDPATH 2>/dev/null || true

# EVERY --repo value is collected, not just the last one. Remembering only
# the last was a real hole: with `--repo A --repo B`, only B was filtered
# against, so an absolute PATH entry inside A survived and could supply the
# very `node` this script is about to exec -- out of a repository the caller
# did name as a review target. The Node side refuses a repeated --repo, but
# that refusal happens after `node` has already been chosen and run, so it
# cannot be what protects this. Verified empirically: a `/A/bin/node` on
# PATH executed with `--repo /A --repo /B`. Filtering against all of them
# makes the bootstrap's decision independent of which value would have won.
#
# The resolved roots are accumulated in the POSITIONAL PARAMETERS rather
# than a delimited string: a path may contain any byte except NUL -- spaces
# and newlines included -- and "$@" is the only POSIX sh list that survives
# that intact. They are APPENDED after the caller's own arguments, which stay
# in place: those arguments are what the final `exec` has to hand to node
# unchanged, so nothing here may consume them. `for arg do` iterates the
# parameter list as it stood when the loop began, so appending inside it is
# safe. The appended tail is removed again just before the exec.
argc=$#
skip_next=false
prev=
for arg do
  if $skip_next; then skip_next=false; prev=; continue; fi
  case $prev in
    --repo)
      prev=
      # Resolve and widen here, in the same pass, so a value that cannot be
      # entered is simply never appended -- an unenterable directory can
      # supply no binary, exactly as in the PATH loop below.
      physical_dir "$arg" || continue
      repo_root=$_phys_result
      # A repository root if one encloses it, otherwise the directory itself.
      if repo_root_of "$repo_root"; then repo_root=$_root_result; fi
      set -- "$@" "$repo_root"
      continue ;;
  esac
  case $arg in --) break ;; esac
  case $arg in
    --model|--effort|--base|--commit|--custom|--context|--timeout|--continue)
      skip_next=true ;;
  esac
  prev=$arg
done
repo_count=$(( $# - argc ))

# The candidate comes first, then the number of leading parameters to skip,
# then the whole parameter list: a function's own positional parameters
# shadow the caller's, so the roots have to be passed in, and they sit behind
# the caller's untouched arguments.
inside_repo() {
  _candidate=$1
  _skip=$2
  shift 2
  case $_candidate in
    "$launch_dir"|"$launch_dir"/*) return 0 ;;
  esac
  while [ "$_skip" -gt 0 ]; do
    shift
    _skip=$((_skip - 1))
  done
  for _root do
    [ -n "$_root" ] || continue
    case $_candidate in
      "$_root"|"$_root"/*) return 0 ;;
    esac
  done
  return 1
}

safe_path=
dropped=0
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  case $dir in
    /*) ;;
    *) continue ;;
  esac
  # An entry that cannot be entered is dropped silently: `cd` needs the same
  # execute bit a PATH search does, so such an entry could never have supplied
  # a binary anyway, and a stale `~/bin` on PATH is too ordinary to warn about.
  # Only a repository-internal entry -- the thing this filter exists to catch
  # -- is worth a line on stderr.
  # physical_dir, not a bare substitution: a PATH entry may itself name a
  # directory whose last component ends in a newline, and a truncated
  # candidate would be compared against untruncated roots.
  physical_dir "$dir" || continue
  real_dir=$_phys_result
  if inside_repo "$real_dir" "$argc" "$@"; then
    dropped=$((dropped + 1))
    continue
  fi
  safe_path=${safe_path:+$safe_path:}$dir
done
IFS=$old_ifs

# Say WHICH roots are filtered, in words, without interpolating any of them.
# The message this replaced blamed "the repository under review" for every
# drop, which is wrong whenever the launch directory's own enclosing
# repository is what matched -- a home directory kept as a dotfiles git
# repository is the ordinary case, and it sends the reader debugging a tree
# that had nothing to do with it.
#
# Naming the actual paths would be more convenient and is deliberately not
# done. They are caller-controlled, this note is on the stream whose markers
# SKILL.md calls authoritative, and two separate forgeries came out of
# interpolating them here: a path holding a real newline split the note into
# standalone lines, and -- with no newline at all -- a path holding the two
# characters `\` and `n` did the same, because `echo` expands backslash
# escapes in every /bin/sh this runs under (verified empirically on macOS's
# /bin/sh, dash, and bash --posix). Escaping is a per-character race that has
# already been lost twice; a note that interpolates nothing cannot lose it
# again. `$dropped` is the loop's own integer counter, not caller data.
# The `hint:` line on the no-node path below carries the dotfiles case, which
# is the situation where knowing the root actually changes what to do.
if [ "$dropped" -gt 0 ]; then
  echo "note: dropped $dropped PATH entry/entries that resolve inside a filtered repository root; every --repo target is filtered, as is any repository enclosing the launch directory" >&2
fi

# An empty PATH is not "search nothing": POSIX command lookup treats an
# empty PATH (and an empty component within one) as the current directory,
# so exporting PATH= here would silently reopen the exact cwd-relative
# lookup this bootstrap exists to close -- verified empirically
# (`env -i PATH= /bin/sh -c 'exec node --version'` runs a `./node` placed in
# cwd). Refuse instead of handing `node` a lookup rule that means "cwd".
if [ -z "$safe_path" ]; then
  echo "error: no absolute PATH entry remains after filtering; refusing rather than falling back to the current directory, which an empty PATH means under POSIX lookup rules." >&2
  echo "hint: set PATH to include the absolute directory that contains node before running this script." >&2
  exit 3
fi
PATH=$safe_path
export PATH

# Without this, a filtered PATH that simply has no `node` on it reaches the
# `exec` below and dies with the shell's own diagnostic and status 127 -- a
# code this skill does not document, from a message that does not say what to
# do about it. `command -v` is a built-in, so it needs nothing on PATH itself.
if ! command -v node >/dev/null 2>&1; then
  echo "error: no 'node' found on the PATH that remains after repository-internal entries were removed." >&2
  echo "error: this script needs Node.js 18 or newer to run." >&2
  echo "hint: install Node.js, or put the absolute directory containing it on PATH from outside the repository under review." >&2
  echo "hint: the launch directory's enclosing repository is filtered too -- if your home directory is itself a git repository (dotfiles), every PATH entry under it was dropped; launch from outside that repository or use a node installed outside it." >&2
  exit 3
fi

# Neutralize Node startup variables that can preload code or write files
# before the .mjs entry point's own baseEnv sanitization takes effect.
# Dynamic-loader variables (LD_PRELOAD, DYLD_*) can affect /bin/sh itself
# and are outside this script's reach; this closes the Node-specific channels.
unset NODE_OPTIONS NODE_PATH NODE_V8_COVERAGE NODE_COMPILE_CACHE NODE_REDIRECT_WARNINGS 2>/dev/null || true

# Resolve node once and reuse the resolved path for both the version check
# and the final exec, so the same binary is tested and run.
node_bin=$(command -v node)
if ! "$node_bin" -e 'process.exit(Number(process.versions.node.split(".")[0]) < 18 ? 1 : 0)' 2>/dev/null; then
  echo "error: Node.js 18 or newer is required; the 'node' on PATH is too old or broken." >&2
  echo "hint: install a current Node.js, or put its directory on PATH." >&2
  exit 3
fi

case $0 in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac

# Drop the resolved repository roots appended above, restoring exactly the
# caller's own arguments for the exec. Rotating the first `argc` parameters
# to the back leaves the appended roots at the front, where a single `shift`
# removes them; the caller's arguments come back in their original order.
# Done by rotation rather than by rebuilding a list, because a `--context` or
# QUESTION argument may contain any byte, and only "$@" carries that through
# unchanged -- passing a mangled argument to node would be a far worse bug
# than the PATH filtering this bookkeeping exists for.
if [ "$repo_count" -gt 0 ]; then
  rotated=0
  while [ "$rotated" -lt "$argc" ]; do
    carried=$1
    shift
    set -- "$@" "$carried"
    rotated=$((rotated + 1))
  done
  shift "$repo_count"
fi

exec "$node_bin" "$script_dir/run-codex-second-opinion.mjs" "$@"
